# PostgreSQL. Two roles, two URLs (see README "Database"):
#   DATABASE_URL           the apps' login: NOSUPERUSER NOBYPASSRLS, owns nothing, so row-level
#                          security applies to every query it runs.
#   MIGRATION_DATABASE_URL the schema owner; used only by `prisma migrate` (schema.prisma directUrl).
# 127.0.0.1, not localhost: on Windows "localhost" tries ::1 first and each new pooled
# connection then stalls ~2s, enough to blow Prisma's 2s transaction maxWait.
# Production: add sslmode=require (or verify-full with sslrootcert) to both.
DATABASE_URL="postgresql://examapp_app:<app-password>@127.0.0.1:5432/examapp?schema=public"
MIGRATION_DATABASE_URL="postgresql://examapp_owner:<owner-password>@127.0.0.1:5432/examapp?schema=public"
# docker-compose only (read from the REPO-ROOT .env, not apps/*/.env): bootstrap credentials for the
# local postgres container. <owner-password>/<app-password> above must match the last two.
# POSTGRES_SUPERUSER_PASSWORD=
# APP_DB_OWNER_PASSWORD=
# APP_DB_APP_PASSWORD=
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL_SECONDS=900
# Staff sessions (P12 Q8). REFRESH_TOKEN_TTL_DAYS no longer applies to staff: a refresh token
# lives exactly as long as its server-side session. Values laxer than the YukthiX floor
# (idle max 480 min, absolute max 12 h) are clamped to it; leave unset for 30 min / 12 h.
# SESSION_IDLE_TIMEOUT_MINUTES=30
# SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# Step-up window for sensitive actions (P12 YX-IAM-02): 15 min floor; may only be shorter.
# STEP_UP_WINDOW_MINUTES=15
# Passkeys (WebAuthn). Default: the RP ID is FRONTEND_URL's host and the allowed origin is
# FRONTEND_URL. Set both explicitly in production (comma-separate several origins).
# WEBAUTHN_RP_ID=app.example.com
# WEBAUTHN_ORIGINS=https://app.example.com
# WEBAUTHN_RP_NAME=YukthiX
# One-time codes (sign-in by email / mobile, text-message fallback factor). Numbers typed without a
# country code are read as this ISO country (default IN). Codes are HMAC-hashed with a key derived
# from ORG_SECRETS_ENCRYPTION_KEY.
# OTP_DEFAULT_COUNTRY=IN
# SMS channel (P04, any gateway by configuration -- docs/sms-gateways/README.md). No SMS provider
# credential is ever an environment variable: gateway accounts live in channel_accounts, encrypted
# with ORG_SECRETS_ENCRYPTION_KEY, and are added in Settings > Notifications > SMS (a company's own
# accounts) or by YukthiX platform staff (the shared account, no organisation). Delivery-report
# callbacks are <API_ORIGIN>/api/v1/notifications/sms/callbacks/<account id>, so API_ORIGIN must be
# the public API URL in production. Outside production a built-in development sink stands in for
# the shared account (messages stay in memory and in the API log, masked); with NODE_ENV=production
# the development provider is refused and texts go only through configured accounts -- with none,
# a sign-in code falls back to email where the company allows email codes.
# Bot challenge on sign-in / one-time-code requests (ASVS V2.2.1): Cloudflare Turnstile. Off until
# both are set (secret on the API, site key in the web build). Fails open if Cloudflare is
# unreachable; the account / IP lockout always applies.
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# New-country sign-in alerts: the header the edge proxy sets to the client's ISO country (e.g.
# cf-ipcountry behind Cloudflare). Only set it behind a proxy that overwrites the header, or a
# client could forge it. Unset = no country recorded, no alerts.
# GEO_COUNTRY_HEADER=cf-ipcountry
API_PORT=3001
# Single sign-on (P12 Part 1e) builds its public URLs from API_ORIGIN: the SAML metadata / ACS
# (<API_ORIGIN>/api/v1/auth/saml/<org>/...) and the one OpenID Connect redirect URI every Google /
# Entra / OIDC app must register (<API_ORIGIN>/api/v1/auth/oidc/callback). The API needs outbound
# HTTPS to each issuer (accounts.google.com, login.microsoftonline.com, a generic issuer) for
# discovery, JWKS and the token exchange. Every one of those requests goes only to a public address
# (DNS-checked and pinned per connection), so a generic issuer cannot point the API at internal hosts.
API_ORIGIN=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
CANDIDATE_JWT_ACCESS_SECRET="dev-candidate-access-secret-change-me"
CANDIDATE_JWT_REFRESH_SECRET="dev-candidate-refresh-secret-change-me"
CANDIDATE_ACCESS_TOKEN_TTL_SECONDS=14400
CANDIDATE_REFRESH_TOKEN_TTL_DAYS=1
ANTHROPIC_API_KEY="sk-ant-dev-key-change-me"
EXAM_RUNTIME_PORT=3002
EXAM_RUNTIME_INTERNAL_URL=http://127.0.0.1:3003
EXAM_RUNTIME_INTERNAL_PORT=3003
EXAM_RUNTIME_INTERNAL_HOST=127.0.0.1
# FACE_EMBEDDING_MODEL_PATH="/path/to/model.onnx" # optional; face verification stays disabled when unset
API_INTERNAL_URL=http://127.0.0.1:3505/api/v1
API_INTERNAL_PORT=3505
API_INTERNAL_HOST=127.0.0.1
INTERNAL_SERVICE_SECRET="dev-internal-secret-change-me"
REDIS_URL="redis://localhost:6379"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="dev-smtp-user-change-me"
SMTP_PASS="dev-smtp-pass-change-me"
# Also encrypts TOTP secrets (P12 YX-IAM-03), OIDC client secrets (Part 1e) and SMS gateway
# account configs (P04) at rest.
ORG_SECRETS_ENCRYPTION_KEY="generate-with-node-crypto-randomBytes-32-toString-hex"

# Observability. Leave SENTRY_DSN unset to disable external error reporting entirely --
# the app logs a warning at boot so an inert deployment is distinguishable from silence.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# apps/web needs its own NEXT_PUBLIC_ variants for the browser: Next.js inlines
# NEXT_PUBLIC_* vars into the client bundle at BUILD time, not read at runtime, so setting
# only these two in the pm2 environment (without SENTRY_DSN/SENTRY_ENVIRONMENT above) would
# leave the browser half of this feature permanently inert regardless of what's set at deploy.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Source maps (BUILD-TIME only -- not read at runtime). These make production stack traces
# de-minify in Sentry. Leave SENTRY_AUTH_TOKEN unset to skip upload entirely (the build still
# works). Only apps/web uploads maps to Sentry (via the @sentry/nextjs build plugin); the node
# apps (api, exam-runtime) instead ship their .js.map and run with `node --enable-source-maps`,
# so they need no token or upload step.
#   SENTRY_AUTH_TOKEN  -- a Sentry org auth token with project:releases scope (keep it secret; set
#                         it only in the web image build / CI, never in the runtime pm2 env).
#   SENTRY_ORG         -- the Sentry organization slug.
#   SENTRY_PROJECT     -- the web project slug (defaults to "exam-web" if unset).
#   SENTRY_RELEASE     -- the release identifier for BOTH the web build (injected into the bundle
#                         so runtime matches the uploaded maps) and the node apps' event tags;
#                         use the git SHA. In a Docker build the .git dir is absent, so set this
#                         explicitly (e.g. --build-arg / build env) or the web release can't be
#                         auto-detected.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=exam-web
SENTRY_RELEASE=

# Self-serve billing (Stripe). Platform-level (one Stripe account for the whole SaaS), so these are
# plain process.env like ANTHROPIC_API_KEY -- NOT per-org encrypted secrets. Leave STRIPE_SECRET_KEY
# unset to disable self-serve checkout entirely: the endpoints return 503 and the billing page hides
# its upgrade/manage controls (inert-until-configured, same as the Sentry DSN). Runtime-read on
# apps/api only.
#   STRIPE_SECRET_KEY      -- Stripe secret API key (sk_live_… / sk_test_…). Secret.
#   STRIPE_WEBHOOK_SECRET  -- the signing secret (whsec_…) for the /api/v1/billing/stripe/webhook
#                             endpoint; used to verify each event's signature. Secret.
# Per-plan Stripe Price/Product ids are stored on the Plan rows (Plan.stripePriceId), set by a
# platform admin via PATCH /platform/plans/:id -- a plan without a stripePriceId is admin-assign-only
# (not purchasable). WEB_ORIGIN (already set above for CORS) is reused to build Checkout/Portal
# return URLs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
