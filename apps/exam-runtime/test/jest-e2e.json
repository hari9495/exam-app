{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "/node_modules/(openid-client|oauth4webapi|jose|franc-min|trigram-utils|n-gram|collapse-white-space|file-type|strtok3|token-types|uint8array-extras|@tokenizer/inflate|@borewit/text-codec|htmlparser2|domelementtype|domhandler|domutils|dom-serializer|entities)/.+\\.js$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true
        },
        "isolatedModules": true
      }
    ],
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(openid-client|oauth4webapi|jose|franc-min|trigram-utils|n-gram|collapse-white-space|file-type|strtok3|token-types|uint8array-extras|@tokenizer/inflate|@borewit/text-codec|htmlparser2|domelementtype|domhandler|domutils|dom-serializer|entities)/)[^/]+/(?!(.*/)?node_modules/)"
  ],
  "maxWorkers": 1
}
