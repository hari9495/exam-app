{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "/node_modules/(openid-client|oauth4webapi|jose|franc-min|trigram-utils|n-gram|collapse-white-space|file-type|strtok3|token-types|uint8array-extras|@tokenizer/inflate|@borewit/text-codec)/.+\\.js$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true
        },
        "isolatedModules": true
      }
    ],
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 30000,
  "setupFiles": [
    "./fixtures/offline-hibp.ts",
    "./fixtures/bull-prefix.ts"
  ],
  "setupFilesAfterEnv": [
    "./fixtures/bull-cleanup.ts"
  ],
  "maxWorkers": 1,
  "workerIdleMemoryLimit": "1GB",
  "transformIgnorePatterns": [
    "/node_modules/(?!(openid-client|oauth4webapi|jose|franc-min|trigram-utils|n-gram|collapse-white-space|file-type|strtok3|token-types|uint8array-extras|@tokenizer/inflate|@borewit/text-codec)/)"
  ]
}
