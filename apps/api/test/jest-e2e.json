{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "/node_modules/(openid-client|oauth4webapi|jose)/.+\\.js$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true
        },
        "isolatedModules": true
      }
    ],
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 30000,
  "setupFiles": [
    "./fixtures/offline-hibp.ts"
  ],
  "maxWorkers": 1,
  "transformIgnorePatterns": [
    "/node_modules/(?!(openid-client|oauth4webapi|jose)/)"
  ]
}
