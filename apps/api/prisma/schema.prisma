  id                     String                  @id @default(uuid()) @db.Uuid
  organizationId         String                  @map("organization_id") @db.Uuid
  jobId                  String                  @map("job_id") @db.Uuid
  candidateId            String                  @map("candidate_id") @db.Uuid
  rejected               Boolean                 @default(false)
  rejectedReason         String?                 @map("rejected_reason") @db.VarChar(1000)
  rejectedAt             DateTime?               @map("rejected_at") @db.Timestamptz(3)
  enteredVia             String                  @map("entered_via") @db.VarChar(1000)
  applicationToken       String?                 @unique @map("application_token") @db.VarChar(1000)
  assignedUserId         String?                 @map("assigned_user_id") @db.Uuid
  assignedGroupId        String?                 @map("assigned_group_id") @db.Uuid
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  statusId               String?                 @map("status_id") @db.Uuid
  archivedAt             DateTime?               @map("archived_at") @db.Timestamptz(3)
  blueprintChecklistJson String?                 @map("blueprint_checklist_json") @db.Text
  referrerUserId         String?                 @map("referrer_user_id") @db.Uuid // set when enteredVia='referral'
  job                    Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  candidate              Candidate               @relation(fields: [candidateId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  status                 PipelineStatus?         @relation(fields: [statusId], references: [id], onDelete: NoAction, onUpdate: NoAction)
