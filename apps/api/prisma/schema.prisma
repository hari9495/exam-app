// ---- P01 §4.4 employee core + P06 effective-dated history (migration 20261008000000_employee_history) ----
// Dated fact tables (assignments, status periods, compensations) are written only through approved
// employee changes (YX-HIS-01) and never updated except to supersede a row (YX-HIS-07): the database
// enforces both (trigger + column grants). Overlap exclusions and partial indexes live in the migration.

model Employee {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// P01 §4.5a: the person this record belongs to (one employee record per person).
  personId       String   @map("person_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  givenName      String   @map("given_name") @db.VarChar(100)
  familyName     String?  @map("family_name") @db.VarChar(100)
  preferredName  String?  @map("preferred_name") @db.VarChar(100)
  workEmail      String?  @map("work_email") @db.Citext
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, id])
  @@map("employees")
}

