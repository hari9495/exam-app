// An employee referral: a staff user refers a person for an open job. The referred person is ingested
// as a candidate + pipeline entry (enteredVia='referral', PipelineEntry.referrerUserId set) exactly
// like an application; this row adds the referral program's own state — who referred, an optional note,
// and the reward/bonus lifecycle the recruiter manages. One referral per pipeline entry.
model Referral {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  referrerUserId String   @map("referrer_user_id") @db.Uuid
  jobId          String   @map("job_id") @db.Uuid
  candidateId    String   @map("candidate_id") @db.Uuid
  entryId        String   @map("entry_id") @db.Uuid
  note           String?  @db.Text
  rewardStatus   String   @default("pending") @map("reward_status") @db.VarChar(1000) // 'pending' | 'approved' | 'paid' | 'rejected'
  rewardNote     String?  @map("reward_note") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([entryId])
  @@index([organizationId, referrerUserId])
  @@index([organizationId, createdAt])
  @@map("referrals")
}

// Candidate-experience survey: an org defines a short question set (rating 1-5 + free text) and either
// sends it manually or auto-fires it when a candidate reaches a target global stage (e.g. 'rejected').
// questionsJson = [{ type: 'rating' | 'text', prompt }]. triggerStage null = manual send only.
model SurveyDefinition {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  name            String   @db.VarChar(200)
  enabled         Boolean  @default(false)
  triggerStage    String?  @map("trigger_stage") @db.VarChar(1000) // a GlobalStage (e.g. 'rejected','hired'); null = manual only
  questionsJson   String   @default("[]") @map("questions_json") @db.Text
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@map("survey_definitions")
}

// One candidate's invite + response to a SurveyDefinition, keyed to their pipeline entry. The token IS
// the authorization for the un-authed public response page. answersJson snapshots [{prompt,type,value}]
// at submit time so aggregates survive later edits to the definition. @@unique keeps one invite per
// survey+entry (repeated stage changes / re-sends don't spam).
model SurveyResponse {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  surveyId       String    @map("survey_id") @db.Uuid
  candidateId    String    @map("candidate_id") @db.Uuid
  entryId        String    @map("entry_id") @db.Uuid
  token          String    @unique @map("token") @db.VarChar(1000)
  status         String    @default("pending") @db.VarChar(1000) // 'pending' | 'submitted'
  answersJson    String?   @map("answers_json") @db.Text
  invitedAt      DateTime  @default(now()) @map("invited_at") @db.Timestamptz(3)
  submittedAt    DateTime? @map("submitted_at") @db.Timestamptz(3)

  @@unique([surveyId, entryId])
  @@index([organizationId, surveyId])
  @@map("survey_responses")
}

