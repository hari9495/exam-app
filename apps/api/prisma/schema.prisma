// Calendar OAuth sync (Zoho #22): one row per user per provider. The platform registers
// one OAuth app per provider (env client id/secret); each recruiter connects their OWN
// account, so we store their refresh/access tokens (encrypted with OrgSecretsCryptoService,
// same AES-256-GCM as smtp/ai/sms secrets). userId is a plain scalar (no User back-relation),
// matching InterviewPanelist. Tenant-scoped -> RLS predicate in the _rls sibling migration.
model CalendarConnection {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  provider              String   @db.VarChar(1000) // 'google' | 'microsoft'
  connectedEmail        String?  @map("connected_email") @db.VarChar(1000)
  accessTokenEncrypted  String   @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String   @map("refresh_token_encrypted") @db.Text
  tokenExpiresAt        DateTime @map("token_expires_at") @db.Timestamptz(3)
  scope                 String?  @db.Text
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, provider])
  @@index([organizationId, userId])
  @@map("calendar_connections")
}

// Transient CSRF/state store for the OAuth redirect round-trip: rawState goes out as the
// `state` param, only its sha256 is stored, and the callback (which carries no JWT) hashes
// the returned state to recover the initiating user/provider. One-time, short TTL. NOT
// RLS-scoped -- looked up by stateHash without a tenant context, exactly like SsoLoginCode.
model CalendarOAuthState {
  id             String   @id @default(uuid()) @db.Uuid
  stateHash      String   @unique @map("state_hash") @db.VarChar(1000)
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  provider       String   @db.VarChar(1000)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("calendar_oauth_states")
}

