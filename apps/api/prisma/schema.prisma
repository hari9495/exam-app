// A recruiter-triggered batch send to many selected candidates. Each batch enqueues one BullMQ job
// that loops the target pipeline entries through CandidateEmailsService.sendMessage (source:'manual'),
// tallying the outcome here so the web can poll live progress. The per-send audit + candidate_emails
// rows are still written by sendMessage; this row is only the batch-level tally.
model CandidateEmailBatch {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  subject         String   @db.Text
  status          String   @default("pending") @db.VarChar(1000) // 'pending' | 'processing' | 'completed'
  total           Int      @default(0)
  sent            Int      @default(0)
  skipped         Int      @default(0)
  failed          Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@map("candidate_email_batches")
}

// A candidate nurture / drip campaign: an ordered list of email steps (stepsJson) sent to enrolled
// candidates on a schedule. steps = [{ subject, body, delayDays }] where delayDays is days after the
// previous step (step 0 = days after enrolment). targetGlobalStage != null auto-enrols a candidate when
// they enter that talent-pool global stage (via pipeline patchEntry); null = manual enrol only. The
// 'drip-steps' scheduled sweep sends due steps via CandidateEmailsService.sendMessage(source:'drip').
model DripCampaign {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  name              String   @db.VarChar(200)
  enabled           Boolean  @default(false)
  targetGlobalStage String?  @map("target_global_stage") @db.VarChar(1000) // e.g. 'available'; null = manual enrol only
  stepsJson         String   @default("[]") @map("steps_json") @db.Text
  createdByUserId   String?  @map("created_by_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@map("drip_campaigns")
}

// One candidate's progress through a DripCampaign. The 'drip-steps' sweep finds active enrolments with
// nextStepDueAt <= now, sends steps[currentStepIndex] against the pipeline entry, advances the index +
// nextStepDueAt, and completes at the end. Exits on hire (pipeline hook) or when a send is skipped
// because the candidate opted out. @@unique keeps auto-enrol idempotent (one enrolment per campaign+candidate).
model DripEnrolment {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  campaignId       String    @map("campaign_id") @db.Uuid
  candidateId      String    @map("candidate_id") @db.Uuid
  entryId          String    @map("entry_id") @db.Uuid
  currentStepIndex Int       @default(0) @map("current_step_index")
  status           String    @default("active") @db.VarChar(1000) // 'active' | 'completed' | 'exited'
  nextStepDueAt    DateTime  @map("next_step_due_at") @db.Timestamptz(3)
  enrolledAt       DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  lastSentAt       DateTime? @map("last_sent_at") @db.Timestamptz(3)
  exitReason       String?   @map("exit_reason") @db.VarChar(1000)

  @@unique([campaignId, candidateId])
  @@index([organizationId, status, nextStepDueAt])
  @@map("drip_enrolments")
}

