  organizationId  String    @map("organization_id") @db.Uuid
  entryId         String    @unique @map("entry_id") @db.Uuid
  jobId           String    @map("job_id") @db.Uuid
  candidateId     String    @map("candidate_id") @db.Uuid
  status          String    @default("pending") @db.VarChar(1000)
  overallScore    Int?      @map("overall_score")
  summary         String?   @db.Text
  strengths       String?   @db.Text
  concerns        String?   @db.Text
  dimensionScores String?   @map("dimension_scores") @db.Text
  criteriaHash    String?   @map("criteria_hash") @db.VarChar(1000)
  modelUsed       String?   @map("model_used") @db.VarChar(1000)
  scoredByUserId  String?   @map("scored_by_user_id") @db.Uuid
  scoredAt        DateTime? @map("scored_at") @db.Timestamptz(3)
