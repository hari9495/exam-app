datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Plan {
  id                     String         @id @default(uuid()) @db.UniqueIdentifier
  name                   String
  candidateLimit         Int            @map("candidate_limit")
  aiCreditLimit          Int            @map("ai_credit_limit")
  proctoringMinutesLimit Int            @map("proctoring_minutes_limit")
  seatLimit              Int            @default(5)  @map("seat_limit")
  priceLabel             String?        @map("price_label")
  billingInterval        String         @default("month") @map("billing_interval")
  isPublic               Boolean        @default(true)  @map("is_public")
  stripeProductId        String?        @map("stripe_product_id")
  stripePriceId          String?        @map("stripe_price_id")
  createdAt              DateTime       @default(now()) @map("created_at")
  organizations          Organization[]

  @@map("plans")
}

model Organization {
  id                     String            @id @default(uuid()) @db.UniqueIdentifier
  name                   String
  slug                   String            @unique
  region                 String            @default("us")
  status                 String            @default("active")
  logoPath               String?           @map("logo_path")
  primaryColor           String?           @map("primary_color")
  accentColor            String?           @map("accent_color")
  textColor              String?           @map("text_color")
  loginWatermarkEnabled  Boolean           @default(false) @map("login_watermark_enabled")
  smtpHost               String?           @map("smtp_host")
  smtpPort               Int?              @map("smtp_port")
  smtpUser               String?           @map("smtp_user")
  smtpPasswordEncrypted  String?           @map("smtp_password_encrypted")
  emailFromAddress       String?           @map("email_from_address")
  aiApiKeyEncrypted      String?           @map("ai_api_key_encrypted")
  aiProvider             String            @default("anthropic") @map("ai_provider")
  aiBaseUrl              String?           @map("ai_base_url")
  aiModelFast            String?           @map("ai_model_fast")
  aiModelStandard        String?           @map("ai_model_standard")
  apiKeyHash             String?           @map("api_key_hash")
  apiKeyPrefix           String?           @map("api_key_prefix")
  apiKeyCreatedAt        DateTime?         @map("api_key_created_at")
  webhookUrl             String?           @map("webhook_url")
  webhookSecretEncrypted String?           @map("webhook_secret_encrypted")
  samlEnabled            Boolean           @default(false) @map("saml_enabled")
  samlIdpEntityId        String?           @map("saml_idp_entity_id")
  samlIdpSsoUrl          String?           @map("saml_idp_sso_url")
  samlIdpCertificate     String?           @map("saml_idp_certificate") @db.NVarChar(Max)
  planId                 String            @map("plan_id") @db.UniqueIdentifier
  plan                   Plan              @relation(fields: [planId], references: [id])
  billingStatus          String            @default("active") @map("billing_status")
  stripeCustomerId       String?           @map("stripe_customer_id")
  stripeSubscriptionId   String?           @map("stripe_subscription_id")
  createdAt              DateTime          @default(now()) @map("created_at")
  users                  User[]
  auditLogs              AuditLog[]
  webhookDeliveries      WebhookDelivery[]

  @@map("organizations")
}

model BillingNotice {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String   @map("organization_id") @db.UniqueIdentifier
  dimension      String
  threshold      Int
  periodStart    DateTime @map("period_start")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, dimension, threshold, periodStart])
  @@index([organizationId])
  @@map("billing_notices")
}

model OrgIntegration {
  id                 String    @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  organizationId     String    @map("organization_id") @db.UniqueIdentifier
  type               String
  label              String
  targetUrlEncrypted String    @map("target_url_encrypted") @db.NVarChar(Max)
  events             String    @db.NVarChar(Max)
  status             String    @default("active")
  lastDeliveryAt     DateTime? @map("last_delivery_at")
  lastError          String?   @map("last_error") @db.NVarChar(Max)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@map("org_integrations")
}

model IntegrationDelivery {
  id             String    @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  organizationId String    @map("organization_id") @db.UniqueIdentifier
  integrationId  String    @map("integration_id") @db.UniqueIdentifier
  eventType      String    @map("event_type")
  status         String    @default("pending")
  httpStatusCode Int?      @map("http_status_code")
  attemptCount   Int       @default(0) @map("attempt_count")
  errorDetail    String?   @map("error_detail") @db.NVarChar(Max)
  createdAt      DateTime  @default(now()) @map("created_at")
  lastAttemptAt  DateTime? @map("last_attempt_at")

  @@map("integration_deliveries")
}

model WebhookDelivery {
  id             String       @id @default(uuid()) @db.UniqueIdentifier
  organizationId String       @map("organization_id") @db.UniqueIdentifier
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventType      String       @map("event_type")
  payloadJson    String       @map("payload_json") @db.NVarChar(Max)
  status         String       @default("pending")
  httpStatusCode Int?         @map("http_status_code")
  attemptCount   Int          @default(0) @map("attempt_count")
  lastAttemptAt  DateTime?    @map("last_attempt_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("webhook_deliveries")
}

model SsoLoginCode {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  codeHash  String   @unique @map("code_hash")
  userId    String   @map("user_id") @db.UniqueIdentifier
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sso_login_codes")
}

model User {
  id                  String               @id @default(uuid()) @db.UniqueIdentifier
  organizationId      String?              @map("organization_id") @db.UniqueIdentifier
  organization        Organization?        @relation(fields: [organizationId], references: [id])
  email               String
  name                String?
  passwordHash        String               @map("password_hash")
  role                String
  status              String               @default("active")
  // Blob path, not a URL. The container is private, so every read has to be
  // SAS-signed on the way out -- see UsersService.toProfileResponse.
  avatarPath          String?              @map("avatar_path")
  lastLoginAt         DateTime?            @map("last_login_at")
  managerId           String?              @map("manager_id") @db.UniqueIdentifier
  createdAt           DateTime             @default(now()) @map("created_at")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  ssoLoginCodes       SsoLoginCode[]
  auditLogs           AuditLog[]

  @@unique([organizationId, email])
  @@map("users")
}

model Permission {
  id              String           @id @default(uuid()) @db.UniqueIdentifier
  key             String           @unique
  description     String
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role         String
  permissionId String     @map("permission_id") @db.UniqueIdentifier
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([role, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.UniqueIdentifier
  userId    String    @map("user_id") @db.UniqueIdentifier
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @map("token_hash")
  familyId  String    @map("family_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.UniqueIdentifier
  userId    String    @map("user_id") @db.UniqueIdentifier
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model SetupToken {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("setup_tokens")
}

// Landing-page "Get Started" submissions. Platform-level, no organizationId -- these are
// prospects who don't have an org yet, unlike everything else in this schema.
model Lead {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  name      String
  workEmail String   @map("work_email")
  company   String
  teamSize  String?  @map("team_size")
  message   String?  @db.NVarChar(Max)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("leads")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.UniqueIdentifier
  organizationId String?       @map("organization_id") @db.UniqueIdentifier
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actorUserId    String?       @map("actor_user_id") @db.UniqueIdentifier
  // onDelete: NoAction here is a schema-validator-only annotation, not the real DB behavior.
  // Prisma's generate/validate step flags this relation and the organization relation above as
  // two ambiguous SetNull-cascade paths into AuditLog (Organization -> AuditLog directly, and
  // Organization -> User -> AuditLog.actor), even though the actual FK constraint -- defined by
  // this project's hand-written migration, never auto-generated from this annotation -- really is
  // ON DELETE SET NULL ON UPDATE NO ACTION, exactly as applied and already accepted by SQL Server.
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action         String
  entityType     String        @map("entity_type")
  entityId       String?       @map("entity_id")
  // Actor identity snapshotted at write time. The live `actor` relation can't be
  // resolved at read time when the viewer is an org-admin and the actor is a
  // super-admin (RLS hides the super-admin's out-of-org user row), which rendered
  // such events as "System". Snapshotting also survives the actor being renamed
  // or deleted later -- both required for a trustworthy audit trail.
  actorEmail     String?       @map("actor_email")
  actorName      String?       @map("actor_name")
  actorRole      String?       @map("actor_role")
  metadataJson   String?       @map("metadata_json") @db.NVarChar(Max)
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@index([entityType])
  @@index([action])
  @@map("audit_logs")
}

// Production error/diagnostic events: unhandled backend exceptions and candidate-browser
// failures, viewable in the admin console without SSH access to pm2 logs. Deliberately no
// Organization FK relation -- org id is a scoping value only (RLS filters on the column),
// and a relation would add another cascade path into the AuditLog-style validator mess.
model SystemEvent {
  id             String   @id @default(uuid()) @db.UniqueIdentifier
  organizationId String?  @map("organization_id") @db.UniqueIdentifier
  // 'api' | 'exam-runtime' | 'candidate-browser'
  service        String
  // 'error' | 'warn'
  severity       String
  message        String   @db.NVarChar(2000)
  contextJson    String?  @map("context_json") @db.NVarChar(Max)
  occurredAt     DateTime @default(now()) @map("occurred_at")

  @@index([organizationId, occurredAt])
  @@index([occurredAt])
  @@index([service])
  @@map("system_events")
}

model Question {
  id                 String                @id @default(uuid()) @db.UniqueIdentifier
  organizationId     String                @map("organization_id") @db.UniqueIdentifier
  type               String
  text               String                @db.NVarChar(Max)
  topic              String?
  category           String?
  difficulty         String
  marks              Int
  negativeMarks      Int                   @default(0) @map("negative_marks")
  status             String                @default("active")
  aiGenerated        Boolean               @default(false) @map("ai_generated")
  aiJobId            String?               @map("ai_job_id") @db.UniqueIdentifier
  languageMode       String                @default("fixed") @map("language_mode")
  allowedLanguages   String?               @map("allowed_languages") @db.NVarChar(Max)
  starterCode        String?               @map("starter_code") @db.NVarChar(Max)
  allowStdin         Boolean               @default(false) @map("allow_stdin")
  snippetCode        String?               @map("snippet_code") @db.NVarChar(Max)
  snippetLanguage    String?               @map("snippet_language")
  imageUrl           String?               @map("image_url")
  createdBy          String                @map("created_by") @db.UniqueIdentifier
  createdAt          DateTime              @default(now()) @map("created_at")
  // Stamped only when an edit actually changes WHICH answers are correct. Item analytics
  // discards responses submitted before this instant: those candidates answered a question
  // whose key was different, so pooling them measures two different items as one -- and it
  // is why a miskeyed question stayed flagged even after a recruiter fixed it.
  // Null means the key has never changed, so every response counts.
  answerKeyChangedAt DateTime?             @map("answer_key_changed_at")
  options            QuestionOption[]
  examLinks          ExamSectionQuestion[]
  answers            Answer[]
  tags               QuestionTag[]
  aiJob              AiJob?                @relation(fields: [aiJobId], references: [id], onDelete: SetNull)

  @@index([organizationId, topic, difficulty])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid()) @db.UniqueIdentifier
  questionId String   @map("question_id") @db.UniqueIdentifier
  text       String
  isCorrect  Boolean  @map("is_correct")
  orderIndex Int      @map("order_index")
  imageUrl   String?  @map("image_url")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

model Tag {
  id             String               @id @default(uuid()) @db.UniqueIdentifier
  organizationId String               @map("organization_id") @db.UniqueIdentifier
  name           String
  createdAt      DateTime             @default(now()) @map("created_at")
  questions      QuestionTag[]
  poolSections   ExamSectionPoolTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model WalkInGroup {
  id             String         @id @default(uuid()) @db.UniqueIdentifier
  organizationId String         @map("organization_id") @db.UniqueIdentifier
  name           String
  createdAt      DateTime       @default(now()) @map("created_at")
  jobId          String?        @map("job_id") @db.UniqueIdentifier
  job            Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  exams          Exam[]
  driveSessions  DriveSession[]

  @@unique([organizationId, name])
  @@index([jobId])
  @@map("walk_in_groups")
}

model DriveSession {
  id             String       @id @default(uuid()) @db.UniqueIdentifier
  organizationId String       @map("organization_id") @db.UniqueIdentifier
  walkInGroupId  String       @map("walk_in_group_id") @db.UniqueIdentifier
  name           String
  startsAt       DateTime     @map("starts_at")
  endsAt         DateTime     @map("ends_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  walkInGroup    WalkInGroup  @relation(fields: [walkInGroupId], references: [id], onUpdate: NoAction)
  invitations    Invitation[]

  @@index([walkInGroupId])
  @@map("drive_sessions")
}

model QuestionTag {
  questionId String   @map("question_id") @db.UniqueIdentifier
  tagId      String   @map("tag_id") @db.UniqueIdentifier
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@map("question_tags")
}

model Exam {
  id                            String        @id @default(uuid()) @db.UniqueIdentifier
  organizationId                String        @map("organization_id") @db.UniqueIdentifier
  title                         String
  instructions                  String?       @db.NVarChar(Max)
  status                        String        @default("draft")
  durationMinutes               Int           @default(60) @map("duration_minutes")
  passCriteriaPercent           Int           @default(40) @map("pass_criteria_percent")
  randomizeOrder                Boolean       @default(false) @map("randomize_order")
  feedbackVisibility            String        @default("pass_fail") @map("feedback_visibility")
  schedulingEnabled             Boolean       @default(false) @map("scheduling_enabled")
  availabilityWindowStart       DateTime?     @map("availability_window_start")
  availabilityWindowEnd         DateTime?     @map("availability_window_end")
  walkInEnabled                 Boolean       @default(false) @map("walk_in_enabled")
  // Independent of walkInEnabled: controls whether this exam appears in the shared
  // /walk-in/{orgSlug} picker alongside every other walk-in-enabled exam, vs. only being
  // reachable via its own exam-specific link/QR (see WalkInShareCard, which always embeds
  // ?exam=<id> regardless of this flag).
  walkInListed                  Boolean       @default(true) @map("walk_in_listed")
  // At most one group per exam -- assigning an exam to a new group moves it out of
  // its old one. A group's own shared link (WalkInShareCard's ?group=<id>) shows
  // exactly its member exams regardless of walkInListed, which only governs the
  // org-wide default picker.
  walkInGroupId                 String?       @map("walk_in_group_id") @db.UniqueIdentifier
  // onDelete/onUpdate declared NoAction here only to satisfy Prisma's client-generation
  // cyclic-referential-actions check (adding WalkInGroup.jobId in 20260820090000 created a
  // second path Job -> WalkInGroup -> Exam -> JobExam alongside the direct Job -> JobExam
  // cascade, which Prisma's validator rejects even though SQL Server itself accepted the
  // new FK). The REAL deployed constraint (20260805020000_walk_in_groups) is still
  // ON DELETE SET NULL ON UPDATE CASCADE -- this annotation doesn't change DB behavior,
  // it only breaks the graph Prisma walks at generate time.
  walkInGroup                   WalkInGroup?  @relation(fields: [walkInGroupId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  allowedIpRange                String?       @map("allowed_ip_range")
  // Master switch for every anti-cheating measure below. Off forces webcam/screen-capture/
  // lockdown to false and every browser-behavior signal disabled at write time (exams.service's
  // resolveProctoringFields), so a stale/duplicated row can't leave monitoring silently active.
  enableAntiCheating            Boolean       @default(true) @map("enable_anti_cheating")
  webcamProctoringEnabled       Boolean       @default(true) @map("webcam_proctoring_enabled")
  // Overrides proctoringEnforcement for webcam violations only: when true, webcam events
  // are still detected, recorded and counted, but never pause or block the exam --
  // regardless of the enforcement mode below, which still governs the "Watch for" browser
  // signals normally. Default false preserves today's behavior (webcam follows the same
  // enforcement as everything else) for every existing exam.
  webcamRecordOnly              Boolean       @default(false) @map("webcam_record_only")
  proctoringEnforcement         String        @default("block") @map("proctoring_enforcement")
  proctoringStrikeLimit         Int           @default(3) @map("proctoring_strike_limit")
  disabledProctoringSignalsJson String?       @map("disabled_proctoring_signals_json") @db.NVarChar(Max)
  screenCaptureEnabled          Boolean       @default(false) @map("screen_capture_enabled")
  lockdownRequired              Boolean       @default(false) @map("lockdown_required")
  faceVerificationEnabled       Boolean       @default(false) @map("face_verification_enabled")
  faceEnrolmentPolicy           String        @default("retry_then_allow") @map("face_enrolment_policy")
  // What happens when a confirmed face mismatch fires mid-exam. Stage 2 ships flag-only: every
  // value is accepted, stored and surfaced to recruiters, but only 'flag' has any candidate-
  // facing effect right now -- see AttemptService's applyFaceMismatchAction and the stage-2
  // brief. warn/pause/block enforcement is deferred to stage 3 pending threshold calibration
  // and a fairness check.
  faceMismatchAction            String        @default("flag") @map("face_mismatch_action")
  createdBy                     String        @map("created_by") @db.UniqueIdentifier
  createdAt                     DateTime      @default(now()) @map("created_at")
  sections                      ExamSection[]
  invitations                   Invitation[]
  jobExams                      JobExam[]

  @@index([organizationId, status])
  @@map("exams")
}

model ExamSection {
  id                    String                @id @default(uuid()) @db.UniqueIdentifier
  examId                String                @map("exam_id") @db.UniqueIdentifier
  title                 String
  orderIndex            Int                   @map("order_index")
  selectionMode         String                @default("fixed") @map("selection_mode")
  poolSize              Int?                  @map("pool_size")
  poolDifficulty        String?               @map("pool_difficulty")
  targetDurationMinutes Int?                  @map("target_duration_minutes")
  // A section's share of the exam's grade, independent of its questions' raw marks -- see
  // docs/superpowers/specs/2026-08-05-section-weightage-design.md. Every exam's sections must
  // sum to exactly 100 before it can be published (enforced in ExamsService#publish).
  weightPercent         Int                   @map("weight_percent")
  // How many of this section's questions the candidate must actually answer. null = all of
  // them (the default and today's behaviour). When set, the best `requiredCount` answers are
  // scored, out of `requiredCount` questions -- see docs/superpowers/specs/
  // 2026-08-05-answer-any-n-design.md. Publish enforces 1 <= requiredCount <= M and that all
  // candidate questions carry equal marks.
  requiredCount         Int?                  @map("required_count")
  exam                  Exam                  @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions             ExamSectionQuestion[]
  poolTags              ExamSectionPoolTag[]

  @@index([examId])
  @@map("exam_sections")
}

model ExamSectionQuestion {
  sectionId  String      @map("section_id") @db.UniqueIdentifier
  questionId String      @map("question_id") @db.UniqueIdentifier
  orderIndex Int         @map("order_index")
  section    ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id])

  @@id([sectionId, questionId])
  @@map("exam_section_questions")
}

model ExamSectionPoolTag {
  sectionId String      @map("section_id") @db.UniqueIdentifier
  tagId     String      @map("tag_id") @db.UniqueIdentifier
  section   ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  tag       Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([sectionId, tagId])
  @@map("exam_section_pool_tags")
}

model Candidate {
  id              String            @id @default(uuid()) @db.UniqueIdentifier
  organizationId  String            @map("organization_id") @db.UniqueIdentifier
  email           String
  name            String
  phone           String?
  status          String            @default("active")
  portalToken     String?           @unique @map("portal_token")
  createdAt       DateTime          @default(now()) @map("created_at")
  erasedAt        DateTime?         @map("erased_at")
  invitations     Invitation[]
  pipelineEntries PipelineEntry[]
  profile         CandidateProfile?
  candidateEmails CandidateEmail[]

  @@unique([organizationId, email])
  @@map("candidates")
}

model CandidateProfile {
  id                    String    @id @default(uuid()) @db.UniqueIdentifier
  organizationId        String    @map("organization_id") @db.UniqueIdentifier
  candidateId           String    @unique @map("candidate_id") @db.UniqueIdentifier
  resumePath            String?   @map("resume_path")
  parseStatus           String    @default("pending") @map("parse_status")
  parsedSummary         String?   @map("parsed_summary") @db.NVarChar(Max)
  parsedSkills          String?   @map("parsed_skills") @db.NVarChar(Max)
  parsedTitle           String?   @map("parsed_title")
  parsedYearsExperience Int?      @map("parsed_years_experience")
  parsedAt              DateTime? @map("parsed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  candidate             Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("candidate_profiles")
}

model Invitation {
  id                     String                  @id @default(uuid()) @db.UniqueIdentifier
  examId                 String                  @map("exam_id") @db.UniqueIdentifier
  candidateId            String                  @map("candidate_id") @db.UniqueIdentifier
  token                  String                  @unique
  status                 String                  @default("invited")
  source                 String                  @default("invited") @map("source")
  // Tracks the invite EMAIL's own lifecycle, separate from `status` (which tracks the
  // invitation itself: invited/revoked). 'pending' until dispatchInvitationEmail's fire-
  // and-forget send resolves, then 'sent' or 'failed' -- lets the recruiter UI show
  // "In queue" for the brief window before the email actually goes out.
  emailStatus            String                  @default("pending") @map("email_status")
  // Set when this invitation was created by "Advance to Next Round" from another exam, so
  // that exam's results table can report whether the invite it triggered actually went out.
  // Deliberately NOT a relation: it is provenance for a UI column, and a FK would make
  // deleting the source exam either fail or cascade-delete a live invitation to a different
  // exam. Null for every hand-made invite, and for everything created before this shipped.
  advancedFromExamId     String?                 @map("advanced_from_exam_id") @db.UniqueIdentifier
  resendCount            Int                     @default(0) @map("resend_count")
  extraTimePercent       Int                     @default(0) @map("extra_time_percent")
  invitedAt              DateTime                @default(now()) @map("invited_at")
  expiresAt              DateTime                @map("expires_at")
  revokedAt              DateTime?               @map("revoked_at")
