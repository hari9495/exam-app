  @@index([organizationId])
  @@map("user_notification_preferences")
}

model Attempt {
  id                            String              @id @default(uuid()) @db.Uuid
  invitationId                  String              @unique @map("invitation_id") @db.Uuid
  candidateId                   String              @map("candidate_id") @db.Uuid
  examId                        String              @map("exam_id") @db.Uuid
  status                        String              @default("in_progress") @db.VarChar(1000)
  questionOrderJson             String              @map("question_order_json") @db.Text
  sectionSnapshotJson           String              @map("section_snapshot_json") @db.Text
  optionOrderJson               String?             @map("option_order_json") @db.Text
  startedAt                     DateTime            @default(now()) @map("started_at") @db.Timestamptz(3)
  submittedAt                   DateTime?           @map("submitted_at") @db.Timestamptz(3)
  deviceFingerprint             String?             @map("device_fingerprint") @db.VarChar(1000)
  lastSeenAt                    DateTime?           @map("last_seen_at") @db.Timestamptz(3)
  webcamViolationCount          Int                 @default(0) @map("webcam_violation_count")
  browserActivityViolationCount Int                 @default(0) @map("browser_activity_violation_count")
  screenCaptureCount            Int                 @default(0) @map("screen_capture_count")
  pausedAt                      DateTime?           @map("paused_at") @db.Timestamptz(3)
  pausedReason                  String?             @map("paused_reason") @db.VarChar(50)
  pausedDurationMs              Int                 @default(0) @map("paused_duration_ms")
  consentAt                     DateTime?           @map("consent_at") @db.Timestamptz(3)
  screenShareStartedAt          DateTime?           @map("screen_share_started_at") @db.Timestamptz(3)
  proctoringBypassedAt          DateTime?           @map("proctoring_bypassed_at") @db.Timestamptz(3)
  proctoringBypassedBy          String?             @map("proctoring_bypassed_by") @db.Uuid
  proctoringBypassReason        String?             @map("proctoring_bypass_reason") @db.VarChar(1000)
  proctoringBypassRevokedAt     DateTime?           @map("proctoring_bypass_revoked_at") @db.Timestamptz(3)
  faceMismatchCount             Int                 @default(0) @map("face_mismatch_count")
  // Stage-3 face-mismatch enforcement: a non-freezing "warn" heads-up. Set when a confirmed
  // mismatch fires on an exam whose faceMismatchAction is 'warn'; the candidate sees a one-time
  // dismissible notice (timer keeps running) and clears it via /attempt/face-warning-ack. pause
  // and block reuse status/pausedReason instead; only warn needs its own field.
  faceWarningAt                 DateTime?           @map("face_warning_at") @db.Timestamptz(3)
  invitation                    Invitation          @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  answers                       Answer[]
  result                        Result?
  proctoringEvents              ProctoringEvent[]
  messages                      CandidateMessage[]
  proctoringAnalysis            ProctoringAnalysis?
  insight                       AttemptInsight?
  integrityAnalysis             IntegrityAnalysis?
  faceEnrolment                 FaceEnrolment?

  @@index([examId, status])
  @@map("attempts")
}

model Answer {
  id                    String            @id @default(uuid()) @db.Uuid
  attemptId             String            @map("attempt_id") @db.Uuid
  questionId            String            @map("question_id") @db.Uuid
  selectedOptionIdsJson String            @map("selected_option_ids_json") @db.Text
  isMarkedForReview     Boolean           @default(false) @map("is_marked_for_review")
  answeredAt            DateTime          @default(now()) @map("answered_at") @db.Timestamptz(3)
  isCorrect             Boolean?          @map("is_correct")
  marksAwarded          Int?              @map("marks_awarded")
  answerText            String?           @map("answer_text") @db.Text
  // file_upload answers: JSON array of { path, fileName, contentType, size } — the candidate's
  // uploaded files (blob paths). Manually graded like code/essay; "attempted" = non-empty array.
  answerFilesJson       String?           @map("answer_files_json") @db.Text
  gradingFeedback       String?           @map("grading_feedback") @db.Text
  codeLanguage          String?           @map("code_language") @db.VarChar(1000)
  telemetryJson         String?           @map("telemetry_json") @db.Text
  attempt               Attempt           @relation(fields: [attemptId], references: [id], onDelete: Cascade)
