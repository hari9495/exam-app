  hrOwnerUserId     String   @map("hr_owner_user_id") @db.Uuid
  status            String   @db.VarChar(12)
  employmentId      String?  @map("employment_id") @db.Uuid
  /// 6b: the accepted ATS offer it came from; the pre-boarder's own answers (sealed JSON) and section progress.
  offerId           String?  @map("offer_id") @db.Uuid
  answersEnc        String?  @map("answers_enc")
  sections          Json     @default("{}")
  completion        Int      @default(0)
  outcome           String?  @db.VarChar(16)
