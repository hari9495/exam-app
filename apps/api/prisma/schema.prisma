}

model Result {
  id              String    @id @default(uuid()) @db.Uuid
  attemptId       String    @unique @map("attempt_id") @db.Uuid
  score           Int
  maxScore        Int       @map("max_score")
  percentage      Float
  passFail        String?   @map("pass_fail") @db.VarChar(1000)
  computedAt      DateTime  @default(now()) @map("computed_at") @db.Timestamptz(3)
  // Per-attempt release override, layered over Exam.resultsReleaseMode. 'released'/'held' force the
  // outcome either way; null = inherit the exam's mode. releasedAt is stamped when it first becomes
  // visible (for display + email idempotency).
  releaseOverride String?   @map("release_override") @db.VarChar(1000)
  releasedAt      DateTime? @map("released_at") @db.Timestamptz(3)
  // Blob path of the generated pass certificate, minted lazily on first download (recruiter or
  // candidate) and reused thereafter.
  certificatePath String?   @map("certificate_path") @db.VarChar(1000)
  attempt         Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("results")
}

