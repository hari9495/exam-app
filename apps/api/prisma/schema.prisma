  timeZone              String              @map("time_zone") @db.VarChar(1000)
  recruiterNote         String?             @map("recruiter_note") @db.Text
  confirmedSlotId       String?             @map("confirmed_slot_id") @db.Uuid
  candidateReschedNote  String?             @map("candidate_resched_note") @db.Text
