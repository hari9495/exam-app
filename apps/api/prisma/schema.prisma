model FaceEnrolment {
  id                 String    @id @default(uuid()) @db.Uuid
  attemptId          String    @unique @map("attempt_id") @db.Uuid
  status             String    @db.VarChar(1000)
  // Populated in stage 2 from referenceImagePath; encrypted with OrgSecretsCryptoService.
  embedding          String?   @db.Text
  referenceImagePath String?   @map("reference_image_path") @db.VarChar(1000)
  qualityJson        String?   @map("quality_json") @db.Text
  // Nullable on purpose: a candidate who DECLINES still gets a not_verified row (so a refusal is
  // a flag with their name on it, not silence), and that row must not claim a consent moment
  // that never happened.
  consentAt          DateTime? @map("consent_at") @db.Timestamptz(3)
  capturedAt         DateTime? @map("captured_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  attempt            Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("face_enrolments")
}

model CandidateMessage {
