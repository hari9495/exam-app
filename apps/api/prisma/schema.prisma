  addressMasked    String?       @map("address_masked") @db.VarChar(40)
  // 'all_service' | 'authentication_only'
  scope            String        @default("all_service") @db.VarChar(32)
  source           String        @db.VarChar(32)
  textVersion      String        @map("text_version") @db.VarChar(32)
  language         String        @default("en") @db.VarChar(8)
  capturedAt       DateTime      @default(now()) @map("captured_at") @db.Timestamptz(3)
  capturedBy       String?       @map("captured_by") @db.Uuid
  evidence         Json?
  withdrawnAt      DateTime?     @map("withdrawn_at") @db.Timestamptz(3)
  withdrawalSource String?       @map("withdrawal_source") @db.VarChar(32)

  @@index([organizationId, channel, addressHash])
  @@map("channel_consents")
