// A company's sign-in identity providers (P12 §4, YX-IAM-04/05): SAML, Google / Entra / generic
// OIDC. Several per company, routed by email domain. Shapes and the JIT floor are database checks.
model IdentityProvider {
  id                        String                   @id @default(uuid()) @db.Uuid
  organizationId            String                   @map("organization_id") @db.Uuid
  organization              Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // 'saml' | 'oidc_google' | 'oidc_entra' | 'oidc_generic'
  type                      String                   @db.VarChar(16)
  name                      String                   @db.VarChar(100)
  // 'active' | 'disabled'
  status                    String                   @default("disabled") @db.VarChar(16)
  samlEntityId              String?                  @map("saml_entity_id") @db.VarChar(1000)
  samlSsoUrl                String?                  @map("saml_sso_url") @db.VarChar(1000)
  samlCertificate           String?                  @map("saml_certificate") @db.Text
  oidcIssuer                String?                  @map("oidc_issuer") @db.VarChar(1000)
  oidcClientId              String?                  @map("oidc_client_id") @db.VarChar(1000)
  // AES-256-GCM (OrgSecretsCryptoService); never returned by the API
  oidcClientSecretEncrypted String?                  @map("oidc_client_secret_encrypted") @db.Text
  entraTenantId             String?                  @map("entra_tenant_id") @db.Uuid
  jitEnabled                Boolean                  @default(false) @map("jit_enabled")
  jitRole                   String?                  @map("jit_role") @db.VarChar(32)
  // The IdP's own MFA claim (amr / acr / AuthnContextClassRef) counts only when an admin trusts it.
  mfaTrusted                Boolean                  @default(false) @map("mfa_trusted")
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  domains                   IdentityProviderDomain[]
  sessions                  Session[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("identity_providers")
}

model IdentityProviderDomain {
  organizationId     String           @map("organization_id") @db.Uuid
  domain             String           @db.VarChar(253)
  identityProviderId String           @map("identity_provider_id") @db.Uuid
  identityProvider   IdentityProvider @relation(fields: [identityProviderId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "identity_provider_domains_provider_fkey")

  @@id([organizationId, domain])
  @@index([identityProviderId])
  @@map("identity_provider_domains")
}

// An email domain the company has proven it owns (DNS TXT, migration 20261007100000_verified_domains).
// Only verified domains route an email-first sign-in straight to the company's identity provider.
model VerifiedDomain {
  organizationId String       @map("organization_id") @db.Uuid
  domain         String       @db.VarChar(253)
  verifiedAt     DateTime     @default(now()) @map("verified_at") @db.Timestamptz(3)
  // Scheduled re-check (W-006, migration 20261007200000_verified_domain_recheck): consecutive real
  // misses; lapsedAt set = no longer routes until the company checks the record again.
  lastCheckedAt  DateTime?    @map("last_checked_at") @db.Timestamptz(3)
  failedChecks   Int          @default(0) @map("failed_checks")
  lapsedAt       DateTime?    @map("lapsed_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, domain])
  @@index([domain])
  @@map("verified_domains")
}

// ---- P04 notification engine: SMS channel (migration 20261006700000_sms_channel) ----------------

// A gateway account. organizationId null = the YukthiX shared account (readable by the platform only).
model ChannelAccount {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String?                @map("organization_id") @db.Uuid
  organization    Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // 'sms'
  channel         String                 @default("sms") @db.VarChar(16)
  // 'http' | 'twilio' | 'dev'
  provider        String                 @db.VarChar(16)
  name            String                 @db.VarChar(100)
  // AES-256-GCM (OrgSecretsCryptoService) JSON config incl. secrets; never returned by the API
  configEncrypted String                 @map("config_encrypted") @db.Text
  sender          String?                @db.VarChar(20)
  dltEntityId     String?                @map("dlt_entity_id") @db.VarChar(30)
  // { otp: { dltTemplateId, body, variables, status } }
  templates       Json                   @default("{}")
  priority        Int                    @default(100)
  // 'active' | 'disabled'
  status          String                 @default("active") @db.VarChar(16)
  createdByUserId String?                @map("created_by_user_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deliveries      NotificationDelivery[]

  @@index([organizationId, channel, priority])
  @@map("channel_accounts")
}

model NotificationDelivery {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String?         @map("organization_id") @db.Uuid
  organization     Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notificationId   String?         @map("notification_id") @db.Uuid
  // 'sms' | 'email'
  channel          String          @db.VarChar(16)
  // 'otp' | 'test'
  kind             String          @db.VarChar(16)
  idempotencyKey   String          @unique @map("idempotency_key") @db.VarChar(128)
  addressMasked    String          @map("address_masked") @db.VarChar(40)
  addressHash      String          @map("address_hash") @db.VarChar(64)
  // 'pending' | 'sent' | 'delivered' | 'failed' | 'fallback' | 'unknown' | 'opted_out'
  status           String          @default("pending") @db.VarChar(16)
  channelAccountId String?         @map("channel_account_id") @db.Uuid
  channelAccount   ChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: SetNull)
  provider         String?         @db.VarChar(16)
  providerMsgId    String?         @map("provider_msg_id") @db.VarChar(200)
  attempts         Int             @default(0)
  error            String?         @db.VarChar(500)
  costUnits        Int             @default(0) @map("cost_units")
  sentAt           DateTime?       @map("sent_at") @db.Timestamptz(3)
  deliveredAt      DateTime?       @map("delivered_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([channelAccountId, providerMsgId])
  @@map("notification_deliveries")
}

// Append-only opt-in record (APX-A §5): the app may only stamp withdrawnAt once.
model ChannelConsent {
