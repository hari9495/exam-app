datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // The app connects as a NOBYPASSRLS role that owns nothing; migrations run as the schema owner.
  directUrl  = env("MIGRATION_DATABASE_URL")
  extensions = [citext]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model Plan {
  id                     String         @id @default(uuid()) @db.Uuid
  name                   String         @db.VarChar(1000)
  candidateLimit         Int            @map("candidate_limit")
  aiCreditLimit          Int            @map("ai_credit_limit")
  proctoringMinutesLimit Int            @map("proctoring_minutes_limit")
  seatLimit              Int            @default(5) @map("seat_limit")
  priceLabel             String?        @map("price_label") @db.VarChar(1000)
  billingInterval        String         @default("month") @map("billing_interval") @db.VarChar(1000)
  isPublic               Boolean        @default(true) @map("is_public")
  stripeProductId        String?        @map("stripe_product_id") @db.VarChar(1000)
  stripePriceId          String?        @map("stripe_price_id") @db.VarChar(1000)
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  organizations          Organization[]

  @@map("plans")
}

model Organization {
  id                            String                    @id @default(uuid()) @db.Uuid
  name                          String                    @db.VarChar(1000)
  slug                          String                    @unique @db.Citext
  region                        String                    @default("us") @db.VarChar(1000)
  status                        String                    @default("active") @db.VarChar(1000)
  logoPath                      String?                   @map("logo_path") @db.VarChar(1000)
  primaryColor                  String?                   @map("primary_color") @db.VarChar(1000)
  accentColor                   String?                   @map("accent_color") @db.VarChar(1000)
  textColor                     String?                   @map("text_color") @db.VarChar(1000)
  loginWatermarkEnabled         Boolean                   @default(false) @map("login_watermark_enabled")
  smtpHost                      String?                   @map("smtp_host") @db.VarChar(1000)
  smtpPort                      Int?                      @map("smtp_port")
  smtpUser                      String?                   @map("smtp_user") @db.VarChar(1000)
  smtpPasswordEncrypted         String?                   @map("smtp_password_encrypted") @db.VarChar(1000)
  emailFromAddress              String?                   @map("email_from_address") @db.VarChar(1000)
  aiApiKeyEncrypted             String?                   @map("ai_api_key_encrypted") @db.VarChar(1000)
  aiProvider                    String                    @default("anthropic") @map("ai_provider") @db.VarChar(1000)
  aiBaseUrl                     String?                   @map("ai_base_url") @db.VarChar(1000)
  aiModelFast                   String?                   @map("ai_model_fast") @db.VarChar(1000)
  aiModelStandard               String?                   @map("ai_model_standard") @db.VarChar(1000)
  // Generic, bring-your-own embeddings provider (OpenAI-compatible /embeddings), decoupled from the
  // chat provider above. Null = semantic search inert for this org.
  embeddingApiKeyEncrypted      String?                   @map("embedding_api_key_encrypted") @db.VarChar(1000)
  embeddingBaseUrl              String?                   @map("embedding_base_url") @db.VarChar(1000)
  embeddingModel                String?                   @map("embedding_model") @db.VarChar(1000)
  apiKeyHash                    String?                   @map("api_key_hash") @db.VarChar(1000)
  /// P11 YX-API-12: what the company API key may do beyond the default (e.g. "payroll-write").
  apiKeyScopes                  String[]                  @default([]) @map("api_key_scopes")
  apiKeyPrefix                  String?                   @map("api_key_prefix") @db.VarChar(1000)
  apiKeyCreatedAt               DateTime?                 @map("api_key_created_at") @db.Timestamptz(3)
  webhookUrl                    String?                   @map("webhook_url") @db.VarChar(1000)
  webhookSecretEncrypted        String?                   @map("webhook_secret_encrypted") @db.VarChar(1000)
  autoArchiveSiblingsOnHire     Boolean                   @default(true) @map("auto_archive_siblings_on_hire")
  businessHoursJson             String?                   @map("business_hours_json") @db.Text
  holidaysJson                  String?                   @map("holidays_json") @db.Text
  fieldPermissionsJson          String?                   @map("field_permissions_json") @db.Text
  recordVisibilityEnabled       Boolean                   @default(false) @map("record_visibility_enabled")
  planId                        String                    @map("plan_id") @db.Uuid
  plan                          Plan                      @relation(fields: [planId], references: [id])
  billingStatus                 String                    @default("active") @map("billing_status") @db.VarChar(1000)
  stripeCustomerId              String?                   @map("stripe_customer_id") @db.VarChar(1000)
  stripeSubscriptionId          String?                   @map("stripe_subscription_id") @db.VarChar(1000)
  createdAt                     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  applyConsentText              String?                   @map("apply_consent_text") @db.Text
  applyConsentVersion           Int                       @default(1) @map("apply_consent_version")
  careersEnabled                Boolean                   @default(false) @map("careers_enabled")
  careersHeadline               String?                   @map("careers_headline") @db.VarChar(1000)
  careersIntro                  String?                   @map("careers_intro") @db.Text
  careersBannerPath             String?                   @map("careers_banner_path") @db.VarChar(1000)
  // Opt-in public AI assistant on the careers site (default off — it is public AI spend).
  careersAssistantEnabled       Boolean                   @default(false) @map("careers_assistant_enabled")
  smsEnabled                    Boolean                   @default(false) @map("sms_enabled")
  smsProvider                   String                    @default("twilio") @map("sms_provider") @db.VarChar(1000)
  smsConfigEncrypted            String?                   @map("sms_config_encrypted") @db.Text
  // External Easy Apply (Indeed/LinkedIn) ingestion creds, encrypted JSON keyed by provider:
  // { "<provider>": { "secret": "..." } }. A provider is enabled iff it has a stored secret;
  // the feature is inert until an org configures one. Same on/off shape as the SMS config blob.
  easyApplyConfigEncrypted      String?                   @map("easy_apply_config_encrypted") @db.Text
  whatsappEnabled               Boolean                   @default(false) @map("whatsapp_enabled")
  whatsappProvider              String                    @default("twilio") @map("whatsapp_provider") @db.VarChar(1000)
  whatsappConfigEncrypted       String?                   @map("whatsapp_config_encrypted") @db.Text
  // HRIS/ATS export: on candidate hire, POST a structured employee record to the org's HRIS inbound
  // API / iPaaS endpoint. Bring-your-own endpoint + auth token; inert until enabled + a target URL
  // is set. hrisAuthHeaderEncrypted holds the full Authorization header value (e.g. "Bearer xxx").
  // Daily staff reminder sweep (pending grading, stale invites, expiring offers, upcoming
  // interviews, feedback owed) — opt-in per org; per-user email opt-out via userNotificationPreference.
  remindersEnabled              Boolean                   @default(false) @map("reminders_enabled")
  // Weekly scheduled-report digest — opt-in per org. Recipients are a JSON array of staff user ids;
  // lastSentAt gates the 7-day cadence (and prevents a restart from re-sending the same week).
  scheduledReportEnabled        Boolean                   @default(false) @map("scheduled_report_enabled")
  scheduledReportRecipientsJson String?                   @map("scheduled_report_recipients_json") @db.Text
  scheduledReportLastSentAt     DateTime?                 @map("scheduled_report_last_sent_at") @db.Timestamptz(3)
  hrisExportEnabled             Boolean                   @default(false) @map("hris_export_enabled")
  hrisProvider                  String                    @default("generic") @map("hris_provider") @db.VarChar(1000)
  hrisTargetUrl                 String?                   @map("hris_target_url") @db.VarChar(1000)
  hrisAuthHeaderEncrypted       String?                   @map("hris_auth_header_encrypted") @db.Text
  /// P14 §3 lifecycle (trial / active / suspended / closed); a trigger keeps `status` (the sign-in switch) in step.
  lifecycle                     String                    @default("active") @db.VarChar(16)
  trialEndsAt                   DateTime?                 @map("trial_ends_at") @db.Timestamptz(3)
  trialExtendedAt               DateTime?                 @map("trial_extended_at") @db.Timestamptz(3)
  lifecycleChangedAt            DateTime                  @default(now()) @map("lifecycle_changed_at") @db.Timestamptz(3)
  /// SD-1.31: YukthiX's own company (slug yukthix), home of the YukthiX Support desk.
  isPlatform                    Boolean                   @default(false) @map("is_platform")
  users                         User[]
  auditLogs                     AuditLog[]
  webhookDeliveries             WebhookDelivery[]
  securityPolicy                TenantSecurityPolicy?
  identityProviders             IdentityProvider[]
  verifiedDomains               VerifiedDomain[]
  externalIdentities            ExternalIdentity[]
  channelAccounts               ChannelAccount[]
  notificationDeliveries        NotificationDelivery[]
  channelConsents               ChannelConsent[]
  notificationPolicy            TenantNotificationPolicy?
  smsUsage                      SmsUsageMonthly[]

  @@map("organizations")
}

model BillingNotice {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  dimension      String   @db.VarChar(1000)
  threshold      Int
  periodStart    DateTime @map("period_start") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, dimension, threshold, periodStart])
  @@index([organizationId])
  @@map("billing_notices")
}

model OrgIntegration {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  type               String    @db.VarChar(1000)
  label              String    @db.VarChar(1000)
  targetUrlEncrypted String    @map("target_url_encrypted") @db.Text
  events             String    @db.Text
  status             String    @default("active") @db.VarChar(1000)
  lastDeliveryAt     DateTime? @map("last_delivery_at") @db.Timestamptz(3)
  lastError          String?   @map("last_error") @db.Text
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("org_integrations")
}

model IntegrationDelivery {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  integrationId  String    @map("integration_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(1000)
  status         String    @default("pending") @db.VarChar(1000)
  httpStatusCode Int?      @map("http_status_code")
  attemptCount   Int       @default(0) @map("attempt_count")
  errorDetail    String?   @map("error_detail") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastAttemptAt  DateTime? @map("last_attempt_at") @db.Timestamptz(3)

  @@map("integration_deliveries")
}

// One row per HRIS export attempt-set for a hired candidate. Mirrors IntegrationDelivery +
// WebhookDelivery (super-admin accessed, not RLS): payloadJson snapshots the employee record at
// hire so a later candidate edit can't rewrite what was exported.
model HrisExportDelivery {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  candidateId    String    @map("candidate_id") @db.Uuid
  payloadJson    String    @map("payload_json") @db.Text
  status         String    @default("pending") @db.VarChar(1000)
  httpStatusCode Int?      @map("http_status_code")
  attemptCount   Int       @default(0) @map("attempt_count")
  errorDetail    String?   @map("error_detail") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastAttemptAt  DateTime? @map("last_attempt_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@map("hris_export_deliveries")
}

model WebhookDelivery {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventType      String       @map("event_type") @db.VarChar(1000)
  payloadJson    String       @map("payload_json") @db.Text
  status         String       @default("pending") @db.VarChar(1000)
  httpStatusCode Int?         @map("http_status_code")
  attemptCount   Int          @default(0) @map("attempt_count")
  lastAttemptAt  DateTime?    @map("last_attempt_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@map("webhook_deliveries")
}

model SsoLoginCode {
  id                 String   @id @default(uuid()) @db.Uuid
  codeHash           String   @unique @map("code_hash") @db.VarChar(1000)
  userId             String   @map("user_id") @db.Uuid
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  // 'saml' | 'oidc'; mfaAsserted: the IdP said it did MFA (the session then starts at AAL2)
  method             String   @default("saml") @db.VarChar(16)
  mfaAsserted        Boolean  @default(false) @map("mfa_asserted")
  // The provider that vouched, and sha256 of the device cookie of the browser that started the
  // sign-in: only that browser may redeem the code (login CSRF).
  identityProviderId String?  @map("identity_provider_id") @db.Uuid
  deviceIdHash       String?  @map("device_id_hash") @db.VarChar(64)

  @@map("sso_login_codes")
}

model User {
  id                     String               @id @default(uuid()) @db.Uuid
  organizationId         String?              @map("organization_id") @db.Uuid
  organization           Organization?        @relation(fields: [organizationId], references: [id])
  email                  String               @db.Citext
  name                   String?              @db.VarChar(1000)
  timeZone               String?              @map("time_zone") @db.VarChar(1000)
  emailSignature         String?              @map("email_signature") @db.Text
  // Notification email cadence: 'immediate' (default = one email per event, today's behavior),
  // 'daily' (batched into one daily digest by the digest sweep), or 'off' (no notification emails at
  // all; the in-app bell is unaffected). lastDigestSentAt anchors the once-per-day digest sweep.
  notificationDigest     String               @default("immediate") @map("notification_digest") @db.VarChar(1000)
  lastDigestSentAt       DateTime?            @map("last_digest_sent_at") @db.Timestamptz(3)
  passwordHash           String               @map("password_hash") @db.VarChar(1000)
  role                   String               @db.VarChar(1000)
  status                 String               @default("active") @db.VarChar(1000)
  // Blob path, not a URL. The container is private, so every read has to be
  // SAS-signed on the way out -- see UsersService.toProfileResponse.
  avatarPath             String?              @map("avatar_path") @db.VarChar(1000)
  lastLoginAt            DateTime?            @map("last_login_at") @db.Timestamptz(3)
  // Set when the breached-password check could not run as this password was chosen (HIBP
  // unreachable, fail-open); the next successful sign-in re-checks it (YX-IAM-08).
  passwordRecheckPending Boolean              @default(false) @map("password_recheck_pending")
  // The re-check found the password in a breach corpus: the next sign-in must change it.
  passwordChangeRequired Boolean              @default(false) @map("password_change_required")
  // MFA must be enrolled by then wherever it is required (P12 §8: 14-day grace for existing
  // accounts); an approved MFA reset sets it to now().
  mfaEnrolmentDueAt      DateTime             @default(dbgenerated("(now() + '14 days'::interval)")) @map("mfa_enrolment_due_at") @db.Timestamptz(3)
  // E.164; signs in by one-time code (and receives SMS / WhatsApp codes) only once verified.
  mobileNumber           String?              @map("mobile_number") @db.VarChar(16)
  mobileVerifiedAt       DateTime?            @map("mobile_verified_at") @db.Timestamptz(3)
  managerId              String?              @map("manager_id") @db.Uuid
  permissionProfileId    String?              @map("permission_profile_id") @db.Uuid
  permissionProfile      PermissionProfile?   @relation(fields: [permissionProfileId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  refreshTokens          RefreshToken[]
  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  ssoLoginCodes          SsoLoginCode[]
  auditLogs              AuditLog[]
  authenticators         Authenticator[]
  recoveryCodes          RecoveryCode[]
  mfaResetRequests       MfaResetRequest[]
  externalIdentities     ExternalIdentity[]

  @@unique([organizationId, email])
  @@map("users")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique @db.VarChar(1000)
  description     String           @db.VarChar(1000)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role         String     @db.VarChar(1000)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([role, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @map("token_hash") @db.VarChar(1000)
  familyId  String    @map("family_id") @db.VarChar(1000)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("refresh_tokens")
}

// Server-side staff session (P12 §4, YX-IAM-06). The refresh-token family IS the session:
// refresh_tokens.family_id = sessions.id, and every access token carries it as `sid`, so
// revoking this row kills its access and refresh tokens at once. Rows are never deleted by
// the app; revoked_at/revoked_reason record why a session ended.
model Session {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String?           @map("organization_id") @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'password' | 'saml'
  method             String            @db.VarChar(32)
  // 'aal1' | 'aal2' (P12 §3)
  assuranceLevel     String            @default("aal1") @map("assurance_level") @db.VarChar(16)
  // sha256 of the opaque device cookie; never the raw value.
  deviceIdHash       String?           @map("device_id_hash") @db.VarChar(64)
  userAgent          String?           @map("user_agent") @db.VarChar(512)
  ipAddress          String?           @map("ip_address") @db.VarChar(64)
  // ISO country from the edge proxy's geo header (GEO_COUNTRY_HEADER); null when not configured.
  geo                String?           @db.VarChar(128)
  idleTimeoutSeconds Int               @map("idle_timeout_seconds")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt         DateTime          @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt      DateTime          @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt  DateTime          @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt          DateTime?         @map("revoked_at") @db.Timestamptz(3)
  revokedReason      String?           @map("revoked_reason") @db.VarChar(64)
  // Last AAL2 proof on this session (second factor at sign-in, enrolment, step-up) and its factor.
  mfaVerifiedAt      DateTime?         @map("mfa_verified_at") @db.Timestamptz(3)
  mfaMethod          String?           @map("mfa_method") @db.VarChar(32)
  // The identity provider that signed this session in (SSO only): disabling it ends the session.
  identityProviderId String?           @map("identity_provider_id") @db.Uuid
  identityProvider   IdentityProvider? @relation(fields: [identityProviderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([organizationId, lastSeenAt])
  @@map("sessions")
}

// A second factor (P12 §4, YX-IAM-03): a WebAuthn passkey or a TOTP app. Revoked, never deleted.
model Authenticator {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String?   @map("organization_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'passkey' | 'totp'
  type            String    @db.VarChar(16)
  label           String    @db.VarChar(64)
  // passkey: base64url credential id, COSE public key, signature counter, transports
  credentialId    String?   @unique @map("credential_id") @db.VarChar(1024)
  publicKey       Bytes?    @map("public_key")
  signCount       BigInt    @default(0) @map("sign_count")
  transports      String[]  @default([]) @db.VarChar(32)
  // totp: AES-256-GCM encrypted base32 secret; last accepted time step (replay protection)
  secretEncrypted String?   @map("secret_encrypted") @db.Text
  totpLastStep    BigInt?   @map("totp_last_step")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("authenticators")
}

// A Google / Microsoft account an account has fully signed in with (migration 20261007300000).
// subject: Google `sub`, Microsoft `<tid>:<oid>`. Matched before any email address.
model ExternalIdentity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 'google' | 'microsoft'
  provider       String       @db.VarChar(16)
  subject        String       @db.VarChar(255)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt     DateTime     @default(now()) @map("last_used_at") @db.Timestamptz(3)

  @@unique([userId, provider])
  @@index([provider, subject])
  @@map("external_identities")
}

// Single-use recovery codes (YX-IAM-11): sha256 only, shown to the user once.
model RecoveryCode {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash       String    @map("code_hash") @db.Char(64)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  usedAt         DateTime? @map("used_at") @db.Timestamptz(3)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

// Admin-initiated MFA reset (YX-IAM-11). For a sensitive-role user a second admin must approve.
model MfaResetRequest {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  targetUserId      String    @map("target_user_id") @db.Uuid
  targetUser        User      @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  requestedByUserId String    @map("requested_by_user_id") @db.Uuid
  approvedByUserId  String?   @map("approved_by_user_id") @db.Uuid
  // 'pending' | 'completed' | 'expired'
  status            String    @default("pending") @db.VarChar(16)
  reason            String    @db.VarChar(500)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(3)

  @@index([organizationId, status])
  @@map("mfa_reset_requests")
}

// A company's security settings (P12 §4, Q8). One row per organisation; no row = YukthiX defaults.
// Every value may only be stricter than the YukthiX floor: enforced by the API (TENANT_SECURITY_FLOOR)
// and again by CHECK constraints in the migration.
model TenantSecurityPolicy {
  organizationId         String       @id @map("organization_id") @db.Uuid
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // 'sensitive_roles' (floor) | 'all'
  mfaScope               String       @default("sensitive_roles") @map("mfa_scope") @db.VarChar(16)
  // subset of passkey / totp / otp; always includes passkey or totp (OTP is fallback only)
  allowedFactors         String[]     @default(["passkey", "totp"]) @map("allowed_factors") @db.VarChar(16)
  // null = platform default (30 min idle, 12 h absolute)
  sessionIdleMinutes     Int?         @map("session_idle_minutes")
  sessionAbsoluteMinutes Int?         @map("session_absolute_minutes")
  // null = no limit; otherwise the oldest live sessions beyond it are signed out at sign-in
  maxConcurrentSessions  Int?         @map("max_concurrent_sessions")
  passwordMinLength      Int          @default(12) @map("password_min_length")
  // IPs / CIDRs; empty = no restriction for that surface
  ipAllowlistDesk        String[]     @default([]) @map("ip_allowlist_desk")
  ipAllowlistAdmin       String[]     @default([]) @map("ip_allowlist_admin")
  ipAllowlistApi         String[]     @default([]) @map("ip_allowlist_api")
  ssoOnly                Boolean      @default(false) @map("sso_only")
  breakGlassUserIds      String[]     @default([]) @map("break_glass_user_ids") @db.Uuid
  // OTP sign-in channels the company allows: subset of email / sms / whatsapp; empty = off
  otpSignInChannels      String[]     @default([]) @map("otp_sign_in_channels") @db.VarChar(16)
  // Account lockout (YX-IAM-07): lock on the Nth consecutive failure (3-10), first lock for M
  // minutes (15-1440), doubling per further lock up to 24 h
  maxFailedAttempts      Int          @default(10) @map("max_failed_attempts")
  lockMinutes            Int          @default(15) @map("lock_minutes")
  // "Continue with Google / Microsoft" (YukthiX's platform OIDC apps); off unless the company turns it on
  googleSignIn           Boolean      @default(false) @map("google_sign_in")
  microsoftSignIn        Boolean      @default(false) @map("microsoft_sign_in")
  updatedAt              DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByUserId        String?      @map("updated_by_user_id") @db.Uuid

  @@map("tenant_security_policies")
}

// Every staff sign-in attempt (P12 §4, YX-IAM-10). Append-only for the app role (P08 pattern:
// UPDATE/DELETE revoked in the migration). No FK to users/organizations on purpose: the record
// must outlive the user it describes, and attempts for unknown users have no user at all.
model LoginEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  // The identifier that was typed (lower-cased email), kept even when no user matched.
  identifier     String?  @db.VarChar(320)
  // 'success' | 'failed' | 'locked' | 'mfa_failed' | 'code_sent' | 'unlocked'
  result         String   @db.VarChar(16)
  // 'password' | 'saml' | 'otp_email' | 'otp_sms' | 'otp_whatsapp' (second-factor failures: the factor)
  method         String   @db.VarChar(32)
  reason         String?  @db.VarChar(64)
  sessionId      String?  @map("session_id") @db.Uuid
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  deviceIdHash   String?  @map("device_id_hash") @db.VarChar(64)
  geo            String?  @db.VarChar(128)
  newDevice      Boolean  @default(false) @map("new_device")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("login_events")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash") @db.VarChar(1000)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("password_reset_tokens")
}

model SetupToken {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(1000)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("setup_tokens")
}

// Landing-page "Get Started" submissions. Platform-level, no organizationId -- these are
// prospects who don't have an org yet, unlike everything else in this schema.
model Lead {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(1000)
  workEmail String   @map("work_email") @db.VarChar(1000)
  company   String   @db.VarChar(1000)
  teamSize  String?  @map("team_size") @db.VarChar(1000)
  message   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("leads")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  action         String        @db.VarChar(1000)
  entityType     String        @map("entity_type") @db.VarChar(1000)
  entityId       String?       @map("entity_id") @db.VarChar(1000)
  // Actor identity snapshotted at write time. The live `actor` relation can't be
  // resolved at read time when the viewer is an org-admin and the actor is a
  // super-admin (RLS hides the super-admin's out-of-org user row), which rendered
  // such events as "System". Snapshotting also survives the actor being renamed
  // or deleted later -- both required for a trustworthy audit trail.
  actorEmail     String?       @map("actor_email") @db.VarChar(1000)
  actorName      String?       @map("actor_name") @db.VarChar(1000)
  actorRole      String?       @map("actor_role") @db.VarChar(1000)
  metadataJson   String?       @map("metadata_json") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  // P08 YX-AUD-03 hash chain, set by the database on insert (audit_chain_link); never written by the app.
  chainKey       String?       @map("chain_key") @db.Uuid
  chainSeq       BigInt?       @map("chain_seq")
  prevHash       String?       @map("prev_hash") @db.Char(64)
  rowHash        String?       @map("row_hash") @db.Char(64)

  @@index([organizationId, createdAt])
  @@index([actorUserId])
  @@index([entityType])
  @@index([action])
  @@map("audit_logs")
}

// Production error/diagnostic events: unhandled backend exceptions and candidate-browser
// failures, viewable in the admin console without SSH access to pm2 logs. Deliberately no
// Organization FK relation -- org id is a scoping value only (RLS filters on the column),
// and a relation would add another cascade path into the AuditLog-style validator mess.
model SystemEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  // 'api' | 'exam-runtime' | 'candidate-browser'
  service        String   @db.VarChar(1000)
  // 'error' | 'warn'
  severity       String   @db.VarChar(1000)
  message        String   @db.VarChar(2000)
  contextJson    String?  @map("context_json") @db.Text
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([organizationId, occurredAt])
  @@index([occurredAt])
  @@index([service])
  @@map("system_events")
}

model Question {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  type               String                @db.VarChar(1000)
  text               String                @db.Text
  topic              String?               @db.VarChar(1000)
  category           String?               @db.VarChar(1000)
  difficulty         String                @db.VarChar(1000)
  marks              Int
  negativeMarks      Int                   @default(0) @map("negative_marks")
  // Opt-in partial credit for a multi_mcq question. When true, a non-exact selection earns
  // proportional marks (correct - wrong, floored at 0) instead of all-or-nothing. Only meaningful
  // for multi_mcq; forced false for every other type in the write path. Default false preserves
  // the existing all-or-nothing behavior for every current question.
  partialCredit      Boolean               @default(false) @map("partial_credit")
  status             String                @default("active") @db.VarChar(1000)
  aiGenerated        Boolean               @default(false) @map("ai_generated")
  aiJobId            String?               @map("ai_job_id") @db.Uuid
  languageMode       String                @default("fixed") @map("language_mode") @db.VarChar(1000)
  allowedLanguages   String?               @map("allowed_languages") @db.Text
  starterCode        String?               @map("starter_code") @db.Text
  allowStdin         Boolean               @default(false) @map("allow_stdin")
  // Auto-grading test cases for a code question (JSON array of {stdin, expectedStdout, weight,
  // hidden}). Null/empty = the question is graded manually, as before.
  codeTestsJson      String?               @map("code_tests_json") @db.Text
  // Recruiter-only reference answer / grading notes for an essay question. Null for other types
  // and never exposed to candidates; shown to the grader in the manual-grading queue.
  modelAnswer        String?               @map("model_answer") @db.Text
  snippetCode        String?               @map("snippet_code") @db.Text
  snippetLanguage    String?               @map("snippet_language") @db.VarChar(1000)
  imageUrl           String?               @map("image_url") @db.VarChar(1000)
  createdBy          String                @map("created_by") @db.Uuid
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  // Stamped only when an edit actually changes WHICH answers are correct. Item analytics
  // discards responses submitted before this instant: those candidates answered a question
  // whose key was different, so pooling them measures two different items as one -- and it
  // is why a miskeyed question stayed flagged even after a recruiter fixed it.
  // Null means the key has never changed, so every response counts.
  answerKeyChangedAt DateTime?             @map("answer_key_changed_at") @db.Timestamptz(3)
  options            QuestionOption[]
  examLinks          ExamSectionQuestion[]
  answers            Answer[]
  tags               QuestionTag[]
  aiJob              AiJob?                @relation(fields: [aiJobId], references: [id], onDelete: SetNull)

  @@index([organizationId, topic, difficulty])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  text       String   @db.VarChar(1000)
  isCorrect  Boolean  @map("is_correct")
  orderIndex Int      @map("order_index")
  imageUrl   String?  @map("image_url") @db.VarChar(1000)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_options")
}

model Tag {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  name           String               @db.VarChar(1000)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  questions      QuestionTag[]
  poolSections   ExamSectionPoolTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model WalkInGroup {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  name            String         @db.VarChar(1000)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  jobId           String?        @map("job_id") @db.Uuid
  deletedAt       DateTime?      @map("deleted_at") @db.Timestamptz(3)
  deletedByUserId String?        @map("deleted_by_user_id") @db.Uuid
  job             Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  exams           Exam[]
  driveSessions   DriveSession[]

  @@unique([organizationId, name])
  @@index([jobId])
  @@map("walk_in_groups")
}

model DriveSession {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  walkInGroupId  String       @map("walk_in_group_id") @db.Uuid
  name           String       @db.VarChar(1000)
  startsAt       DateTime     @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime     @map("ends_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  walkInGroup    WalkInGroup  @relation(fields: [walkInGroupId], references: [id], onUpdate: NoAction)
  invitations    Invitation[]

  @@index([walkInGroupId])
  @@map("drive_sessions")
}

model QuestionTag {
  questionId String   @map("question_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@map("question_tags")
}

model Exam {
  id                            String        @id @default(uuid()) @db.Uuid
  organizationId                String        @map("organization_id") @db.Uuid
  title                         String        @db.VarChar(1000)
  instructions                  String?       @db.Text
  status                        String        @default("draft") @db.VarChar(1000)
  durationMinutes               Int           @default(60) @map("duration_minutes")
  passCriteriaPercent           Int           @default(40) @map("pass_criteria_percent")
  randomizeOrder                Boolean       @default(false) @map("randomize_order")
  feedbackVisibility            String        @default("pass_fail") @map("feedback_visibility") @db.VarChar(1000)
  // 'immediate' (default, behavior-preserving): a settled result is shown to the candidate at once.
  // 'manual': the result is withheld until a recruiter releases it (per-attempt override on Result).
  resultsReleaseMode            String        @default("immediate") @map("results_release_mode") @db.VarChar(1000)
  // Issue a downloadable certificate to candidates who pass this exam (inert until enabled).
  certificatesEnabled           Boolean       @default(false) @map("certificates_enabled")
  schedulingEnabled             Boolean       @default(false) @map("scheduling_enabled")
  availabilityWindowStart       DateTime?     @map("availability_window_start") @db.Timestamptz(3)
  availabilityWindowEnd         DateTime?     @map("availability_window_end") @db.Timestamptz(3)
  walkInEnabled                 Boolean       @default(false) @map("walk_in_enabled")
  // Independent of walkInEnabled: controls whether this exam appears in the shared
  // /walk-in/{orgSlug} picker alongside every other walk-in-enabled exam, vs. only being
  // reachable via its own exam-specific link/QR (see WalkInShareCard, which always embeds
  // ?exam=<id> regardless of this flag).
  walkInListed                  Boolean       @default(true) @map("walk_in_listed")
  // At most one group per exam -- assigning an exam to a new group moves it out of
  // its old one. A group's own shared link (WalkInShareCard's ?group=<id>) shows
  // exactly its member exams regardless of walkInListed, which only governs the
  // org-wide default picker.
  walkInGroupId                 String?       @map("walk_in_group_id") @db.Uuid
  walkInGroup                   WalkInGroup?  @relation(fields: [walkInGroupId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  allowedIpRange                String?       @map("allowed_ip_range") @db.VarChar(1000)
  // Master switch for every anti-cheating measure below. Off forces webcam/screen-capture/
  // lockdown to false and every browser-behavior signal disabled at write time (exams.service's
  // resolveProctoringFields), so a stale/duplicated row can't leave monitoring silently active.
  enableAntiCheating            Boolean       @default(true) @map("enable_anti_cheating")
  webcamProctoringEnabled       Boolean       @default(true) @map("webcam_proctoring_enabled")
  // Opt-in: send a sample of the stored webcam snapshots to a vision LLM at settlement to flag
  // suspicious behaviour (another person, a phone, looking away, no candidate). Default OFF -- the
  // org explicitly enables sending frames to the model; flag-for-review only, never auto-strike.
  webcamAiAnalysisEnabled       Boolean       @default(false) @map("webcam_ai_analysis_enabled")
  // Overrides proctoringEnforcement for webcam violations only: when true, webcam events
  // are still detected, recorded and counted, but never pause or block the exam --
  // regardless of the enforcement mode below, which still governs the "Watch for" browser
  // signals normally. Default false preserves today's behavior (webcam follows the same
  // enforcement as everything else) for every existing exam.
  webcamRecordOnly              Boolean       @default(false) @map("webcam_record_only")
  proctoringEnforcement         String        @default("block") @map("proctoring_enforcement") @db.VarChar(1000)
  proctoringStrikeLimit         Int           @default(3) @map("proctoring_strike_limit")
  disabledProctoringSignalsJson String?       @map("disabled_proctoring_signals_json") @db.Text
  screenCaptureEnabled          Boolean       @default(false) @map("screen_capture_enabled")
  lockdownRequired              Boolean       @default(false) @map("lockdown_required")
  faceVerificationEnabled       Boolean       @default(false) @map("face_verification_enabled")
  faceEnrolmentPolicy           String        @default("retry_then_allow") @map("face_enrolment_policy") @db.VarChar(1000)
  // What happens when a confirmed face mismatch fires mid-exam. Stage 2 ships flag-only: every
  // value is accepted, stored and surfaced to recruiters, but only 'flag' has any candidate-
  // facing effect right now -- see AttemptService's applyFaceMismatchAction and the stage-2
  // brief. warn/pause/block enforcement is deferred to stage 3 pending threshold calibration
  // and a fairness check.
  faceMismatchAction            String        @default("flag") @map("face_mismatch_action") @db.VarChar(1000)
  createdBy                     String        @map("created_by") @db.Uuid
  createdAt                     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  sections                      ExamSection[]
  invitations                   Invitation[]
  jobExams                      JobExam[]

  @@index([organizationId, status])
  @@map("exams")
}

model ExamSection {
  id                    String                @id @default(uuid()) @db.Uuid
  examId                String                @map("exam_id") @db.Uuid
  title                 String                @db.VarChar(1000)
  orderIndex            Int                   @map("order_index")
  selectionMode         String                @default("fixed") @map("selection_mode") @db.VarChar(1000)
  poolSize              Int?                  @map("pool_size")
  poolDifficulty        String?               @map("pool_difficulty") @db.VarChar(1000)
  targetDurationMinutes Int?                  @map("target_duration_minutes")
  // A section's share of the exam's grade, independent of its questions' raw marks -- see
  // docs/superpowers/specs/2026-08-05-section-weightage-design.md. Every exam's sections must
  // sum to exactly 100 before it can be published (enforced in ExamsService#publish).
  weightPercent         Int                   @map("weight_percent")
  // How many of this section's questions the candidate must actually answer. null = all of
  // them (the default and today's behaviour). When set, the best `requiredCount` answers are
  // scored, out of `requiredCount` questions -- see docs/superpowers/specs/
  // 2026-08-05-answer-any-n-design.md. Publish enforces 1 <= requiredCount <= M and that all
  // candidate questions carry equal marks.
  requiredCount         Int?                  @map("required_count")
  exam                  Exam                  @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions             ExamSectionQuestion[]
  poolTags              ExamSectionPoolTag[]

  @@index([examId])
  @@map("exam_sections")
}

model ExamSectionQuestion {
  sectionId  String      @map("section_id") @db.Uuid
  questionId String      @map("question_id") @db.Uuid
  orderIndex Int         @map("order_index")
  section    ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id])

  @@id([sectionId, questionId])
  @@map("exam_section_questions")
}

model ExamSectionPoolTag {
  sectionId String      @map("section_id") @db.Uuid
  tagId     String      @map("tag_id") @db.Uuid
  section   ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  tag       Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([sectionId, tagId])
  @@map("exam_section_pool_tags")
}

model Candidate {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  email              String              @db.Citext
  name               String              @db.VarChar(1000)
  phone              String?             @db.VarChar(1000)
  status             String              @default("active") @db.VarChar(1000)
  globalStage        String              @default("new") @map("global_stage") @db.VarChar(1000)
  portalToken        String?             @unique @map("portal_token") @db.VarChar(1000)
  unsubscribeToken   String?             @unique @map("unsubscribe_token") @db.VarChar(1000)
  emailOptedOutAt    DateTime?           @map("email_opted_out_at") @db.Timestamptz(3)
  whatsappOptedOutAt DateTime?           @map("whatsapp_opted_out_at") @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  erasedAt           DateTime?           @map("erased_at") @db.Timestamptz(3)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamptz(3)
  deletedByUserId    String?             @map("deleted_by_user_id") @db.Uuid
  consentedAt        DateTime?           @map("consented_at") @db.Timestamptz(3)
  consentVersion     Int?                @map("consent_version")
  smsOptedOutAt      DateTime?           @map("sms_opted_out_at") @db.Timestamptz(3)
  invitations        Invitation[]
  pipelineEntries    PipelineEntry[]
  profile            CandidateProfile?
  candidateEmails    CandidateEmail[]
  candidateSms       CandidateSms[]
  candidateWhatsapp  CandidateWhatsapp[]

  @@unique([organizationId, email])
  @@index([organizationId, globalStage])
  @@map("candidates")
}

model CandidateProfile {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  candidateId           String    @unique @map("candidate_id") @db.Uuid
  resumePath            String?   @map("resume_path") @db.VarChar(1000)
  parseStatus           String    @default("pending") @map("parse_status") @db.VarChar(1000)
  parsedSummary         String?   @map("parsed_summary") @db.Text
  parsedSkills          String?   @map("parsed_skills") @db.Text
  parsedTitle           String?   @map("parsed_title") @db.VarChar(1000)
  parsedYearsExperience Int?      @map("parsed_years_experience")
  parsedAt              DateTime? @map("parsed_at") @db.Timestamptz(3)
  // Semantic-search embedding of the parsed résumé text. embeddingHash guards re-embeds (text+model);
  // embeddingModel records which model produced the vector so a model switch re-embeds everyone.
  embeddingJson         String?   @map("embedding_json") @db.Text
  embeddingModel        String?   @map("embedding_model") @db.VarChar(1000)
  embeddingHash         String?   @map("embedding_hash") @db.VarChar(1000)
  embeddedAt            DateTime? @map("embedded_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  candidate             Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("candidate_profiles")
}

model Invitation {
  id                     String                  @id @default(uuid()) @db.Uuid
  examId                 String                  @map("exam_id") @db.Uuid
  candidateId            String                  @map("candidate_id") @db.Uuid
  token                  String                  @unique @db.VarChar(1000)
  status                 String                  @default("invited") @db.VarChar(1000)
  source                 String                  @default("invited") @map("source") @db.VarChar(1000)
  // Tracks the invite EMAIL's own lifecycle, separate from `status` (which tracks the
  // invitation itself: invited/revoked). 'pending' until dispatchInvitationEmail's fire-
  // and-forget send resolves, then 'sent' or 'failed' -- lets the recruiter UI show
  // "In queue" for the brief window before the email actually goes out.
  emailStatus            String                  @default("pending") @map("email_status") @db.VarChar(1000)
  // Set when this invitation was created by "Advance to Next Round" from another exam, so
  // that exam's results table can report whether the invite it triggered actually went out.
  // Deliberately NOT a relation: it is provenance for a UI column, and a FK would make
  // deleting the source exam either fail or cascade-delete a live invitation to a different
  // exam. Null for every hand-made invite, and for everything created before this shipped.
  advancedFromExamId     String?                 @map("advanced_from_exam_id") @db.Uuid
  resendCount            Int                     @default(0) @map("resend_count")
  extraTimePercent       Int                     @default(0) @map("extra_time_percent")
