  organizationId String   @map("organization_id") @db.Uuid
  groupId        String   @map("group_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([groupId, userId])
  @@index([organizationId, userId])
  @@map("user_group_members")
}

model OrgSenderAddress {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  label          String   @db.VarChar(200)
  address        String   @db.VarChar(320)
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, address])
  @@index([organizationId])
  @@map("org_sender_addresses")
}

model ApiUsageDaily {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  day            DateTime @map("day") @db.Date
  endpoint       String   @map("endpoint") @db.VarChar(1000)
  requestCount   Int      @default(0) @map("request_count")
  throttledCount Int      @default(0) @map("throttled_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, day, endpoint])
  @@index([organizationId, day])
  @@map("api_usage_daily")
}

model PermissionProfile {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  name                 String   @db.VarChar(200)
  permissionsJson      String   @map("permissions_json") @db.Text
  // Optional per-user field rules (entity->field->level). Overlaid per-field on the org role config
  // for users assigned this profile. Null = inherit role field rules entirely.
  fieldPermissionsJson String?  @map("field_permissions_json") @db.Text
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  users                User[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("permission_profiles")
}

// Per-org override of a staff role's default permission set (Salesforce-style role editing). When a
// row exists for (org, role), it REPLACES the global role_permissions default for users of that role
// in that org (resolved in PermissionsGuard). No row = the global seed default. Only the editable
// roles (hiring_manager/recruiter/panel) ever get a row — the API refuses the rest. Tenant-scoped
// (organization_id) -> RLS-paired migration. permissionsJson is a JSON string[] of permission keys,
// same shape as PermissionProfile.
model OrgRolePermission {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  role            String   @db.VarChar(1000)
  permissionsJson String   @map("permissions_json") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([organizationId, role])
  @@index([organizationId])
  @@map("org_role_permissions")
}

model JobBoard {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  name            String                @db.VarChar(200)
  feedToken       String                @unique @map("feed_token") @db.VarChar(1000)
  // Paid job-board adapters (Zoho backlog): a board is either the default free XML-feed board
  // (pull) or a paid push board with per-org encrypted API creds. configEncrypted holds the
  // adapter's config blob (AES-256-GCM, same as smtp/sms/ai secrets); null until configured.
  provider        String                @default("xml_feed") @map("provider") @db.VarChar(1000) // 'xml_feed' | 'linkedin' | 'indeed' | 'http'
  configEncrypted String?               @map("config_encrypted") @db.Text
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  publications    JobBoardPublication[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("job_boards")
}

model JobBoardPublication {
  jobBoardId     String    @map("job_board_id") @db.Uuid
  jobId          String    @map("job_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  // Paid push tracking: null for free XML-feed boards. externalPostId is the id the board's API
  // returned, needed to close/remove the posting later. postStatus: pending|posted|failed|removed.
  externalPostId String?   @map("external_post_id") @db.Text
  postStatus     String?   @map("post_status") @db.VarChar(1000)
  postError      String?   @map("post_error") @db.Text
  postedAt       DateTime? @map("posted_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  jobBoard       JobBoard  @relation(fields: [jobBoardId], references: [id], onDelete: Cascade)
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([jobBoardId, jobId])
  @@index([jobId])
  @@index([organizationId])
  @@map("job_board_publications")
}

model Agency {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  name           String             @db.VarChar(200)
  contactEmail   String?            @map("contact_email") @db.VarChar(1000)
  portalToken    String             @unique @map("portal_token") @db.VarChar(1000)
  active         Boolean            @default(true)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  agencyJobs     AgencyJob[]
  submissions    AgencySubmission[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("agencies")
}

model AgencyJob {
  agencyId       String   @map("agency_id") @db.Uuid
  jobId          String   @map("job_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  agency         Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([agencyId, jobId])
  @@index([jobId])
  @@index([organizationId])
  @@map("agency_jobs")
}

model AgencySubmission {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  agencyId         String    @map("agency_id") @db.Uuid
  jobId            String    @map("job_id") @db.Uuid
  candidateName    String    @map("candidate_name") @db.VarChar(1000)
  candidateEmail   String    @map("candidate_email") @db.VarChar(1000)
  candidatePhone   String?   @map("candidate_phone") @db.VarChar(1000)
  resumePath       String    @map("resume_path") @db.VarChar(1000)
  isDuplicate      Boolean   @default(false) @map("is_duplicate")
  status           String    @default("pending") @db.VarChar(1000) // 'pending' | 'accepted' | 'rejected'
  candidateId      String?   @map("candidate_id") @db.Uuid
  reviewedByUserId String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  agency           Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  job              Job       @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organizationId, status])
  @@index([agencyId])
  @@map("agency_submissions")
}

// A company's sign-in identity providers (P12 §4, YX-IAM-04/05): SAML, Google / Entra / generic
// OIDC. Several per company, routed by email domain. Shapes and the JIT floor are database checks.
model IdentityProvider {
  id                        String                   @id @default(uuid()) @db.Uuid
  organizationId            String                   @map("organization_id") @db.Uuid
  organization              Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // 'saml' | 'oidc_google' | 'oidc_entra' | 'oidc_generic'
  type                      String                   @db.VarChar(16)
  name                      String                   @db.VarChar(100)
  // 'active' | 'disabled'
  status                    String                   @default("disabled") @db.VarChar(16)
  samlEntityId              String?                  @map("saml_entity_id") @db.VarChar(1000)
  samlSsoUrl                String?                  @map("saml_sso_url") @db.VarChar(1000)
  samlCertificate           String?                  @map("saml_certificate") @db.Text
  oidcIssuer                String?                  @map("oidc_issuer") @db.VarChar(1000)
  oidcClientId              String?                  @map("oidc_client_id") @db.VarChar(1000)
  // AES-256-GCM (OrgSecretsCryptoService); never returned by the API
  oidcClientSecretEncrypted String?                  @map("oidc_client_secret_encrypted") @db.Text
  entraTenantId             String?                  @map("entra_tenant_id") @db.Uuid
  jitEnabled                Boolean                  @default(false) @map("jit_enabled")
  jitRole                   String?                  @map("jit_role") @db.VarChar(32)
  // The IdP's own MFA claim (amr / acr / AuthnContextClassRef) counts only when an admin trusts it.
  mfaTrusted                Boolean                  @default(false) @map("mfa_trusted")
  createdAt                 DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  domains                   IdentityProviderDomain[]
  sessions                  Session[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("identity_providers")
}

model IdentityProviderDomain {
  organizationId     String           @map("organization_id") @db.Uuid
  domain             String           @db.VarChar(253)
  identityProviderId String           @map("identity_provider_id") @db.Uuid
  identityProvider   IdentityProvider @relation(fields: [identityProviderId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "identity_provider_domains_provider_fkey")

  @@id([organizationId, domain])
  @@index([identityProviderId])
  @@map("identity_provider_domains")
}

// An email domain the company has proven it owns (DNS TXT, migration 20261007100000_verified_domains).
// Only verified domains route an email-first sign-in straight to the company's identity provider.
model VerifiedDomain {
  organizationId String       @map("organization_id") @db.Uuid
  domain         String       @db.VarChar(253)
  verifiedAt     DateTime     @default(now()) @map("verified_at") @db.Timestamptz(3)
  // Scheduled re-check (W-006, migration 20261007200000_verified_domain_recheck): consecutive real
  // misses; lapsedAt set = no longer routes until the company checks the record again.
  lastCheckedAt  DateTime?    @map("last_checked_at") @db.Timestamptz(3)
  failedChecks   Int          @default(0) @map("failed_checks")
  lapsedAt       DateTime?    @map("lapsed_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, domain])
  @@index([domain])
  @@map("verified_domains")
}

// ---- P04 notification engine: SMS channel (migration 20261006700000_sms_channel) ----------------

// A gateway account. organizationId null = the YukthiX shared account (readable by the platform only).
model ChannelAccount {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String?                @map("organization_id") @db.Uuid
  organization     Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // 'sms'
  channel          String                 @default("sms") @db.VarChar(16)
  // 'http' | 'twilio' | 'dev'
  provider         String                 @db.VarChar(16)
  name             String                 @db.VarChar(100)
  // AES-256-GCM (OrgSecretsCryptoService) JSON config incl. secrets; never returned by the API
  configEncrypted  String                 @map("config_encrypted") @db.Text
  sender           String?                @db.VarChar(20)
  dltEntityId      String?                @map("dlt_entity_id") @db.VarChar(30)
  // { otp: { dltTemplateId, body, variables, status } }
  templates        Json                   @default("{}")
  priority         Int                    @default(100)
  // 'active' | 'disabled'
  status           String                 @default("active") @db.VarChar(16)
  createdByUserId  String?                @map("created_by_user_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deliveries       NotificationDelivery[]

  @@index([organizationId, channel, priority])
  @@map("channel_accounts")
}

model NotificationDelivery {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String?         @map("organization_id") @db.Uuid
  organization     Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notificationId   String?         @map("notification_id") @db.Uuid
  // 'sms' | 'email'
  channel          String          @db.VarChar(16)
  // 'otp' | 'test'
  kind             String          @db.VarChar(16)
  idempotencyKey   String          @unique @map("idempotency_key") @db.VarChar(128)
  addressMasked    String          @map("address_masked") @db.VarChar(40)
  addressHash      String          @map("address_hash") @db.VarChar(64)
  // 'pending' | 'sent' | 'delivered' | 'failed' | 'fallback' | 'unknown' | 'opted_out'
  status           String          @default("pending") @db.VarChar(16)
  channelAccountId String?         @map("channel_account_id") @db.Uuid
  channelAccount   ChannelAccount? @relation(fields: [channelAccountId], references: [id], onDelete: SetNull)
  provider         String?         @db.VarChar(16)
  providerMsgId    String?         @map("provider_msg_id") @db.VarChar(200)
  attempts         Int             @default(0)
  error            String?         @db.VarChar(500)
  costUnits        Int             @default(0) @map("cost_units")
  sentAt           DateTime?       @map("sent_at") @db.Timestamptz(3)
  deliveredAt      DateTime?       @map("delivered_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([channelAccountId, providerMsgId])
  @@map("notification_deliveries")
}

// Append-only opt-in record (APX-A §5): the app may only stamp withdrawnAt once.
model ChannelConsent {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String?       @map("organization_id") @db.Uuid
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipientType    String        @map("recipient_type") @db.VarChar(32)
  recipientId      String?       @map("recipient_id") @db.Uuid
  // 'sms' | 'whatsapp'
  channel          String        @db.VarChar(16)
  addressHash      String        @map("address_hash") @db.VarChar(64)
  addressMasked    String?       @map("address_masked") @db.VarChar(40)
  // 'all_service' | 'authentication_only'
  scope            String        @default("all_service") @db.VarChar(32)
  source           String        @db.VarChar(32)
  textVersion      String        @map("text_version") @db.VarChar(32)
  language         String        @default("en") @db.VarChar(8)
  capturedAt       DateTime      @default(now()) @map("captured_at") @db.Timestamptz(3)
  capturedBy       String?       @map("captured_by") @db.Uuid
  evidence         Json?
  withdrawnAt      DateTime?     @map("withdrawn_at") @db.Timestamptz(3)
  withdrawalSource String?       @map("withdrawal_source") @db.VarChar(32)

  @@index([organizationId, channel, addressHash])
  @@map("channel_consents")
}

model TenantNotificationPolicy {
  organizationId   String       @id @map("organization_id") @db.Uuid
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  smsSharedAccount Boolean      @default(true) @map("sms_shared_account")
  // null = no cap
  smsMonthlyCap    Int?         @map("sms_monthly_cap")
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByUserId  String?      @map("updated_by_user_id") @db.Uuid

  @@map("tenant_notification_policies")
}

model SmsUsageMonthly {
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  month          DateTime     @db.Date
  sentCount      Int          @default(0) @map("sent_count")
  capAlertedAt   DateTime?    @map("cap_alerted_at") @db.Timestamptz(3)

  @@id([organizationId, month])
  @@map("sms_usage_monthly")
}
