    {
      "statute": "IN.IR",
      "jurisdiction": "IN",
      "version": "2025-v1",
      "validFrom": "2025-11-21",
      "validTo": null,
      "lawVersion": "CODE",
      "verify": true,
      "source": "Industrial Relations Code, 2020 s.70 (retrenchment: one month's notice or wages in lieu, 15 days' average pay for every completed year of continuous service or part over six months), s.83 (worker re-skilling fund: the employer pays 15 days' last wages) and s.79 (permission before retrenchment at 300 workers or more).",
      "values": {
        "kind": "retrenchment",
        "compensationDays": 15,
        "monthDays": 26,
        "noticeMonths": 1,
        "reskillingDays": 15,
        "permissionThreshold": 300
      },
      "golden": [
        {
          "name": "6 years 7 months at 26,000, notice paid, 120 workers",
          "fn": "retrenchment",
          "input": {
            "averagePay": "26000",
            "lastWage": "26000",
            "joined": "2019-03-01",
            "lastDay": "2025-12-15",
            "noticePaid": true,
            "workers": 120
          },
          "expected": {
            "years": 7,
            "compensation": "105000",
            "noticePay": "26000",
            "reskillingFund": "15000",
            "permissionNeeded": false
          }
        }
      ]
    },
    {
      "statute": "IN.EXIT-EXEMPT",
      "jurisdiction": "IN",
      "version": "2023-v1",
      "validFrom": "2023-04-01",
      "validTo": "2026-03-31",
      "lawVersion": "IT-1961",
      "verify": true,
      "source": "Income-tax Act, 1961: s.10(10)(iii) gratuity up to ₹20,00,000; s.10(10AA)(ii) leave encashment on leaving up to ₹25,00,000 (from 1 Apr 2023); s.10(10B) retrenchment compensation up to ₹5,00,000. Limits are for a lifetime; earlier claims are not counted here (verify).",
      "values": {
        "kind": "exit_exempt",
        "items": [
          {
            "code": "gratuity",
            "cap": "2000000",
            "section": "s.10(10)(iii)"
          },
          {
            "code": "leave_encashment",
            "cap": "2500000",
            "section": "s.10(10AA)(ii)"
          },
          {
            "code": "retrenchment_comp",
            "cap": "500000",
            "section": "s.10(10B)"
          }
        ]
      },
      "golden": [
        {
          "name": "Gratuity 3,00,000: all exempt",
          "fn": "exit_exempt",
          "input": {
            "code": "gratuity",
            "amount": "300000"
          },
          "expected": {
            "exempt": "300000"
          }
        },
        {
          "name": "Retrenchment 7,00,000: 5,00,000 exempt",
          "fn": "exit_exempt",
          "input": {
            "code": "retrenchment_comp",
            "amount": "700000"
          },
          "expected": {
            "exempt": "500000"
          }
        }
      ]
    },
